{
  "schemaVersion": 1,
  "package": "M-Bedrock-Dev Toolchain",
  "target": {
    "developerOs": [
      "Windows 10 x64",
      "Windows 11 x64"
    ],
    "runtimeOs": [
      "Windows 10 x64",
      "Windows 11 x64",
      "Linux CI x64"
    ],
    "architecture": "x86_64"
  },
  "policy": {
    "nodeMajorPinned": true,
    "pythonMandatory": false,
    "rustMandatory": false,
    "globalBuildToolsRequired": false,
    "endUserToolchainRequired": false,
    "nodeVersionPinned": true,
    "npmVersionPinned": true,
    "lockfileRequired": true
  },
  "node": {
    "major": 24,
    "channel": "LTS",
    "scope": [
      "developer-build",
      "cli-runtime"
    ],
    "pinPolicy": "exact developer/build version; package engines remain Node 24 compatible",
    "version": "24.21.0"
  },
  "npm": {
    "source": "bundled-with-node",
    "lockfile": "package-lock.json",
    "scope": [
      "developer-build"
    ],
    "version": "11.19.0",
    "pinPolicy": "exact developer/build version paired with pinned Node",
    "installMode": "npm ci",
    "installScripts": "explicit allowlist in package.json#allowScripts"
  },
  "typescript": {
    "source": "package-lock.json",
    "strict": true
  },
  "powershell": {
    "minimumMajor": 7,
    "scope": [
      "windows-developer-routing"
    ]
  }
}
