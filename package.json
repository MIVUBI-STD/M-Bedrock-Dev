{
  "name": "m-bedrock-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft Bedrock and Minecraft Education content-engineering workspace",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "npm run verify:full",
    "verify:repository": "node tooling/repository/verify.mjs && node tooling/repository/verify-boundaries.mjs",
    "verify:boundaries": "node tooling/repository/verify-boundaries.mjs",
    "verify:source": "npm run typecheck && npm test",
    "verify:full": "npm run verify:repository && npm run verify:source",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx apps/cli/src/main.ts"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.17.0",
    "prismarine-nbt": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
