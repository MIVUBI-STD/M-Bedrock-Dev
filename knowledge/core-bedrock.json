    {
      "id": "command.coordinate.relative-origin",
      "domain": "commands",
      "subject": "coordinates",
      "statement": "Tilde coordinates are relative to the current execution origin; execution context therefore changes their meaning.",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-commands-intro"
      ],
      "capabilityTags": [
        "command:coordinates"
      ],
      "riskSurfaces": [
        "execution-context",
        "coordinate-transform"
      ],
      "diagnosticHints": [
        "Do not treat relative coordinates as globally absolute.",
        "Nested execute context can change coordinate meaning."
      ]
    },
    {
