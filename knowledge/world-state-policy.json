        "recovery"
      ],
      "riskSurfaces": [
        "world-drift",
        "restart-inconsistent"
      ]
    },
    {
      "id": "worldstate-policy.difficulty-not-arena-local",
      "domain": "world-state",
      "subject": "difficulty policy",
      "statement": "Arena-specific difficulty scaling should prefer entity stats/AI/wave configuration where feasible rather than changing world difficulty during concurrent sessions; world difficulty changes require global arbitration.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-state-policy-v1"
