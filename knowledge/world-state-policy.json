        "weather",
        "time"
      ],
      "riskSurfaces": [
        "cross-arena-visual-state"
      ]
    },
    {
      "id": "worldstate-policy.commandblock-rule-protected",
      "domain": "world-state",
      "subject": "commandblocksenabled",
      "statement": "commandblocksenabled is a protected global automation switch. Arena-specific logic must never toggle it casually because disabling it can break unrelated automation graphs across the entire world.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
