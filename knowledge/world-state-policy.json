      "riskSurfaces": [
        "cross-arena-difficulty"
      ]
    },
    {
      "id": "worldstate-policy.time-weather-cinematic-guard",
      "domain": "world-state",
      "subject": "cinematic time/weather",
      "statement": "Cinematics that alter world time or weather must be marked global-impact. Independent per-arena cinematics should prefer local camera/visual techniques where possible instead of modifying the shared environment.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
