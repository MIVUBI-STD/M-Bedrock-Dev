  "facts": [
    {
      "id": "worldstate-policy.global-resource-registry",
      "domain": "world-state",
      "subject": "global world resource",
      "statement": "Track gamerules, difficulty, time/daylight, weather, command-block enablement, world spawn, and other world-global settings in an explicit global-resource registry. These are shared resources, not arena-local state.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-state-policy-v1"
      ],
      "capabilityTags": [
        "global-resource",
        "registry"
      ],
      "riskSurfaces": [
        "hidden-global-state",
        "cross-arena-effect"
      ]
    },
    {
      "id": "worldstate-policy.no-arena-local-assumption",
      "domain": "world-state",
      "subject": "arena use of gamerules",
      "statement": "Arena code must not treat a gamerule or world setting as local to that arena. Any temporary change requires a global conflict check and ownership policy.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-state-policy-v1"
      ],
      "capabilityTags": [
        "arena-isolation",
        "global-state"
      ],
      "riskSurfaces": [
        "multi-arena-conflict"
      ]
    },
    {
      "id": "worldstate-policy.global-lease",
      "domain": "world-state",
      "subject": "temporary global setting",
      "statement": "Temporary world-level changes use a scoped global lease containing setting name, previous value, requested value, owner arena/system, generation, priority, compatibility constraints, and restore condition.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-state-policy-v1"
      ],
      "capabilityTags": [
        "lease",
        "global-state"
      ],
      "riskSurfaces": [
        "restore-race",
        "setting-leak"
      ]
    },
    {
      "id": "worldstate-policy.conflict-arbitration",
      "domain": "world-state",
      "subject": "conflicting global leases",
      "statement": "If two active arenas require incompatible values for the same global setting, do not let last-write-wins decide behavior. Reject, serialize, emulate locally, or choose an explicitly supported shared policy.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-state-policy-v1"
      ],
      "capabilityTags": [
        "conflict",
        "arbitration"
      ],
      "riskSurfaces": [
        "last-write-wins",
        "arena-interference"
      ]
    },
    {
      "id": "worldstate-policy.prefer-local-emulation",
      "domain": "world-state",
      "subject": "arena-specific rule",
      "statement": "Prefer arena-scoped script/filter logic over changing world-global gamerules when simultaneous arenas may require different behavior; examples include friendly-fire filtering, inventory retention, damage suppression, and spawn control.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-state-policy-v1"
      ],
      "capabilityTags": [
        "local-emulation",
        "arena-isolation"
      ],
      "riskSurfaces": [
        "global-policy-conflict"
      ]
    },
    {
      "id": "worldstate-policy.restore-compare-and-swap",
      "domain": "world-state",
      "subject": "global setting restore",
      "statement": "Restoring a global setting should verify the current owner/value before writing the previous value. A stale arena cleanup must not overwrite a newer valid lease from another arena/system.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-state-policy-v1"
      ],
      "capabilityTags": [
        "restore",
        "compare-and-swap"
      ],
      "riskSurfaces": [
        "stale-restore",
        "new-owner-overwrite"
      ]
    },
    {
      "id": "worldstate-policy.baseline-declared",
      "domain": "world-state",
      "subject": "world baseline",
      "statement": "Project runtime must declare expected baseline values for critical global settings and verify them at worldLoad/recovery and after cleanup when no active lease remains.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-state-policy-v1"
      ],
      "capabilityTags": [
