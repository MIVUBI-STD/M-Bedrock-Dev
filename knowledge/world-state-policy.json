      ]
    },
    {
      "id": "worldstate-policy.audit-global-mutations",
      "domain": "world-state",
      "subject": "global mutation audit",
      "statement": "High-impact global setting changes should emit audit evidence with actor/system, setting, previous value, requested value, owner/generation, conflict result, and restore result.",
