      ],
      "riskSurfaces": [
        "hidden-state",
        "automation-coupling"
      ]
    },
    {
      "id": "blockstate.container-events-separate",
      "domain": "interactive-blocks",
      "subject": "block container lifecycle",
      "statement": "The server module exposes block-container opened/closed events separately from block interaction events, so container access is its own runtime lifecycle surface rather than just a generic block click.",
      "classification": "engine-fact",
      "applicability": {
