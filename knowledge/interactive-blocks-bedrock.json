  "facts": [
    {
      "id": "blockstate.type-and-permutation-distinct",
      "domain": "interactive-blocks",
      "subject": "block state",
      "statement": "A block's type and its BlockPermutation are distinct layers; the permutation carries state values that can change behavior and appearance without changing the base block type.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-block-state-permutation",
        "ms-block-class"
      ],
      "capabilityTags": [
        "block-permutation",
        "block-state"
      ],
      "riskSurfaces": [
        "type-correct-state-wrong",
        "visual-behavior-drift"
      ]
    },
    {
      "id": "blockstate.vanilla-open-bit",
      "domain": "interactive-blocks",
      "subject": "doors gates trapdoors",
      "statement": "Vanilla doors, fence gates, and trapdoors expose block states such as open_bit together with orientation/hinge/upper-half states, so route availability can differ even when the expected block type is present.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-block-listings"
      ],
      "capabilityTags": [
        "open_bit",
        "door",
        "gate"
      ],
      "riskSurfaces": [
        "closed-route",
        "wrong-orientation"
      ]
    },
    {
      "id": "blockstate.block-access-can-fail-unloaded",
      "domain": "interactive-blocks",
      "subject": "Block.permutation and mutation",
      "statement": "Reading or changing block type/permutation can throw LocationInUnloadedChunkError or LocationOutOfWorldBoundariesError, and mutation methods cannot run in restricted-execution mode.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-block-class"
      ],
      "capabilityTags": [
        "block-access",
        "chunk-readiness"
      ],
      "riskSurfaces": [
        "unloaded-chunk",
        "partial-object-reset"
      ]
    },
    {
      "id": "blockstate.block-inventory-container",
      "domain": "interactive-blocks",
      "subject": "BlockInventoryComponent",
      "statement": "Inventory-bearing blocks expose a separate container through BlockInventoryComponent; the container may be unavailable or error, so block existence alone does not prove its contents are valid or accessible.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-block-inventory"
      ],
      "capabilityTags": [
        "block-inventory",
        "container"
      ],
      "riskSurfaces": [
        "container-state-drift",
        "stale-container"
      ]
    },
    {
      "id": "blockstate.block-components-many-surfaces",
      "domain": "interactive-blocks",
      "subject": "block components",
      "statement": "Blocks may expose additional components such as inventory, piston, redstone producer, movable, record player, fluid container, dynamic properties, sign, and crafting components, making interactive block state broader than type/permutation alone.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
