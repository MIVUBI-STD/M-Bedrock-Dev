    {
      "id": "education.npc.initiator-only-dialogue-context",
      "domain": "education",
      "subject": "@initiator",
      "statement": "@initiator identifies the player who initiated an NPC dialogue interaction and is specific to NPC dialogue context.",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-target-selectors",
        "ms-npc-dialogue"
      ],
      "capabilityTags": [
        "education:npc",
        "selector"
      ],
      "riskSurfaces": [
        "npc-dialogue",
        "selector-context",
        "multiplayer-state"
      ],
      "diagnosticHints": [
        "Do not interpret @initiator as equivalent to @s; in NPC dialogue @s is the NPC while @initiator is the interacting player."
      ]
    },
