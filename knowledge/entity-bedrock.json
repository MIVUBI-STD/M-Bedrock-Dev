      "id": "entity.open-door-needs-path-through-door",
      "domain": "entity-ai",
      "subject": "minecraft:behavior.open_door",
      "statement": "Open-door behavior requires the mob to be able to path through doors; otherwise it will not attempt to open them.",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
