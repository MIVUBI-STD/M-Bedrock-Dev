    {
      "id": "entity.event.effects-deferred-to-tick",
      "domain": "entity-events",
      "subject": "event-execution",
      "statement": "Event effects are determined immediately but component changes are applied when the entity ticks server-side; later sequence filters do not observe pending changes from earlier entries.",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-entity-events"
      ],
      "capabilityTags": [
        "entity-events"
      ],
      "riskSurfaces": [
        "event-ordering",
        "tick-ordering"
      ],
      "diagnosticHints": [
        "Do not assume add/remove component-group effects are visible to later filters in the same event sequence."
      ]
    },
    {
      "id": "entity.event.cross-entity-tick-order",
      "domain": "entity-events",
      "subject": "cross-entity-event",
      "statement": "When one entity sends an event to another, the effect can occur on the same or next game tick depending on target update order.",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-entity-events"
      ],
      "capabilityTags": [
        "entity-events"
      ],
      "riskSurfaces": [
        "tick-ordering",
        "cross-entity-events",
        "multiplayer-concurrency"
      ]
    },
    {
