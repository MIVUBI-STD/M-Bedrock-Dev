      ],
      "riskSurfaces": [
        "navigation",
        "doors",
        "entity-stuck"
      ],
      "diagnosticHints": [
        "If an entity stops at a door, inspect navigation door-path capability before blaming the open-door goal."
      ]
    },
    {
      "id": "entity.break-door-navigation-owned",
      "domain": "navigation",
      "subject": "door-breaking",
