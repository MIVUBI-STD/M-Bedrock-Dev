        "block-state"
      ],
      "riskSurfaces": [
        "command-block-runtime",
        "inventory-state",
        "hidden-world-state"
      ]
    },
    {
      "id": "world-mutation.setblock-can-fail-unloaded",
      "domain": "world-mutation",
      "subject": "Dimension.setBlockPermutation",
      "statement": "Direct block mutation can throw LocationInUnloadedChunkError when the destination chunk is not loaded, so block writes require chunk readiness or explicit recovery.",
