      ]
    },
    {
      "id": "world-mutation.createfromworld-defaults-include",
      "domain": "world-mutation",
      "subject": "StructureCreateOptions",
      "statement": "StructureCreateOptions defaults includeBlocks and includeEntities to true, so dynamically captured structures can unintentionally include entities unless options explicitly narrow the snapshot.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
