  "facts": [
    {
      "id": "world-mutation.structure-load-can-include-entities-blocks",
      "domain": "world-mutation",
      "subject": "/structure load",
      "statement": "Structure loading can independently include blocks and entities, with optional rotation, mirroring, animation, waterlogging, integrity, and seed parameters. The resulting world mutation therefore depends on more than the structure identifier and destination alone.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-structure-command"
      ],
      "capabilityTags": [
        "structure-load",
        "entities",
        "blocks"
      ],
      "riskSurfaces": [
        "duplicate-entity",
        "partial-world-mutation",
        "wrong-transform"
      ]
    },
    {
      "id": "world-mutation.structure-integrity-can-be-partial",
      "domain": "world-mutation",
      "subject": "structure integrity",
      "statement": "Structure load integrity can intentionally place only a probabilistic subset of blocks, so successful command execution does not always imply a complete block-for-block reconstruction.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-structure-command"
      ],
      "capabilityTags": [
        "structure-load",
        "integrity"
      ],
      "riskSurfaces": [
        "partial-world-mutation",
        "readiness-proof"
      ]
    },
    {
      "id": "world-mutation.structure-animation-is-time-spread",
      "domain": "world-mutation",
      "subject": "structure animation",
      "statement": "Structure loads may use block-by-block or layer-by-layer animation over a configured duration, so command acceptance is not necessarily equivalent to all intended blocks being present immediately.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-structure-command"
      ],
      "capabilityTags": [
        "structure-animation",
        "deferred-world-mutation"
      ],
      "riskSurfaces": [
        "timing-assumption",
        "readiness-proof"
      ]
    },
    {
      "id": "world-mutation.structure-manager-place-queues-unloaded",
      "domain": "world-mutation",
      "subject": "StructureManager.place",
      "statement": "StructureManager.place can queue a structure placement when destination chunks are unloaded, so placement request return is not universal proof that the destination world state is already materialized and ready for dependent gameplay.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-structure-manager"
      ],
      "capabilityTags": [
        "StructureManager.place",
        "chunk-loading"
      ],
      "riskSurfaces": [
        "queued-placement",
        "false-readiness",
        "chunk-lifecycle"
      ]
    },
    {
      "id": "world-mutation.structure-manager-restricted-execution",
      "domain": "world-mutation",
      "subject": "StructureManager mutation APIs",
      "statement": "StructureManager mutation methods such as create/place cannot be called from restricted-execution mode and may throw engine/argument errors.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-structure-manager"
      ],
      "capabilityTags": [
