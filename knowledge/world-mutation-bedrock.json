        "world-mutation-failure"
      ]
    },
    {
      "id": "world-mutation.structure-save-includes-stateful-block-data",
      "domain": "world-mutation",
      "subject": "structure saved block state",
      "statement": "Structure data preserves block state, including stateful blocks such as command blocks, chests/inventories, and structure blocks, so loading a structure can restore embedded runtime-relevant block data rather than only visual blocks.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
