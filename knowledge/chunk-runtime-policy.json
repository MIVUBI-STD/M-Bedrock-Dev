      ],
      "riskSurfaces": [
        "script-version",
        "resource-limit"
      ]
    },
    {
      "id": "chunk-policy.script-manager-capacity-queue",
      "domain": "chunks",
      "subject": "script-tickingarea-capacity",
      "statement": "For the Script API TickingAreaManager backend, queue requests by hasCapacity/maxChunkCount rather than imposing the command system's fixed 10-area limit.",
