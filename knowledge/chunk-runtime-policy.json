        "arena-setup",
        "player-driven-loading"
      ],
      "riskSurfaces": [
        "chunk-lifecycle",
        "runtime-variance"
      ]
    },
    {
      "id": "chunk-policy.loader-side-effect-scan",
      "domain": "chunks",
      "subject": "loader-player-side-effects",
      "statement": "Before choosing player-driven coverage for an arena, inspect original-pack listeners and mechanics that react to player game-mode changes, dimension changes, location/zone transitions, or player movement. If relocation can mutate gameplay state without a setup guard, use a non-player loading backend for setup.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "arena-setup",
        "side-effect-isolation"
      ],
      "riskSurfaces": [
        "gameplay-state",
        "player-state",
        "event-order"
      ],
      "diagnosticHints": [
        "ARENA_SETUP_LOADER_SIDE_EFFECT_RISK"
      ]
    },
    {
      "id": "chunk-policy.control-plane-liveness",
      "domain": "chunks",
      "subject": "setup-control-plane",
      "statement": "Do not move the only player away from a control plane whose countdown/setup orchestration depends on command blocks or other simulation-distance-bound systems in the source area. The coordinator must prove its own control plane remains live while coverage loading occurs.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "arena-setup",
        "control-plane-liveness"
      ],
      "riskSurfaces": [
        "command-block-runtime",
        "chunk-lifecycle",
        "load-order"
      ],
      "diagnosticHints": [
        "ARENA_SETUP_CONTROL_PLANE_AT_RISK"
      ]
    },
    {
      "id": "chunk-policy.global-loader-lease-manager",
      "domain": "chunks",
      "subject": "loader-player-concurrency",
      "statement": "A player may hold at most one loader lease at a time. Multi-arena setup must use a global loader allocator and setup-concurrency budget so the same player cannot be teleported by competing arenas and mass coverage loading cannot activate excessive entity AI simultaneously.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
