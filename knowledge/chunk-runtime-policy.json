        "TICKING_AREA_ORPHANED_LEASE"
      ]
    },
    {
      "id": "chunk-policy.command-backend-external-contention",
      "domain": "chunks",
      "subject": "command-tickingarea-global-contention",
      "statement": "The command backend uses a world-global ticking-area resource. Do not assume all 10 areas belong to this manager; other commands/content may consume capacity, so command-add failure is authoritative and the manager must use namespaced ownership plus conservative reconciliation.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
