        "entity-lifecycle"
      ]
    },
    {
      "id": "chunk-policy.runtime-fallback-only",
      "domain": "chunks",
      "subject": "runtime-tickingarea-policy",
      "statement": "Temporary ticking areas are runtime recovery tools for chunk-related entity operations, not permanent arena loaders and not a default dependency for every arena.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "chunk-recovery",
        "temporary-tickingarea"
      ],
      "riskSurfaces": [
        "resource-limit",
        "chunk-lifecycle"
      ]
    },
    {
      "id": "chunk-policy.spawn-retry-specific-error",
      "domain": "chunks",
      "subject": "spawnEntity-recovery",
      "statement": "Only unloaded-chunk evidence such as LocationInUnloadedChunkError should route spawnEntity into chunk recovery; validation, identifier, boundary, or other spawn errors must preserve their original error classification.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "chunk-recovery",
        "spawn-retry"
      ],
      "riskSurfaces": [
        "entity-lifecycle",
        "chunk-lifecycle"
      ]
    },
    {
      "id": "chunk-policy.persistent-entity-registry",
      "domain": "chunks",
      "subject": "persistent-entity-registry",
      "statement": "Critical persistent entities such as spawners must retain at least entity id, dimension, and last known location; type/tag/role identity should also be retained when available to detect stale or ambiguous resolution.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "entity-registry",
        "chunk-recovery"
      ],
      "riskSurfaces": [
        "entity-lifecycle",
        "chunk-lifecycle"
      ]
    },
    {
      "id": "chunk-policy.get-entity-not-immediately-lost",
      "domain": "chunks",
      "subject": "getEntity-recovery",
      "statement": "If a critical persistent entity lookup returns undefined, do not immediately classify the entity as lost when a last known location exists; first prove the known chunk is loaded, perform temporary recovery loading if required, and retry the lookup.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "entity-registry",
        "chunk-recovery"
      ],
      "riskSurfaces": [
        "entity-lifecycle",
        "chunk-lifecycle"
      ],
      "diagnosticHints": [
        "If no trustworthy last known location exists, fail explicitly with CHUNK_RECOVERY_LOCATION_UNKNOWN rather than loading arbitrary chunks."
      ]
    },
    {
      "id": "chunk-policy.runtime-backend-selection",
      "domain": "chunks",
      "subject": "chunk-recovery-backend",
      "statement": "Prefer world.tickingAreaManager when the declared @minecraft/server line exposes it; use /tickingarea command as a compatibility fallback for older targets.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
