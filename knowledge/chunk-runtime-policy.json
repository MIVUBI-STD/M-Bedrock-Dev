    {
      "id": "chunk-policy.tickingarea-lease-cleanup",
      "domain": "chunks",
      "subject": "temporary-tickingarea-lease",
      "statement": "Every temporary ticking-area request is a lease with unique id, owning arena/session, reason, bounds, timeout, and cleanup in a finally-equivalent path; leaked leases are diagnosable failures.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
