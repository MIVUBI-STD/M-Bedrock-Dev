      ]
    },
    {
      "id": "chunk-policy.spawn-retry-deduplicate",
      "domain": "chunks",
      "subject": "spawn-retry-idempotency",
      "statement": "Before retrying a spawn after chunk recovery, check for an already-created logical target using a unique role/tag/property identity when possible. Recovery must not create duplicate critical entities if the previous attempt completed but its result was not observed.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
