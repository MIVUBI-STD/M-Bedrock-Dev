    {
      "id": "chunk-policy.tickingarea-player-presence-classification",
      "domain": "chunks",
      "subject": "recovery-semantics-classification",
      "statement": "Classify recovery operations as load-only or player-presence-required. Ticking-area recovery is valid only for load-only operations; mechanics whose semantics depend on nearby players must use an actual player-presence strategy.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "chunk-recovery",
        "player-presence-required"
      ],
      "riskSurfaces": [
        "mob-spawning",
        "gameplay-semantics"
      ]
    },
    {
      "id": "chunk-policy.tickingarea-serialized-allocation",
      "domain": "chunks",
      "subject": "script-tickingarea-allocation",
      "statement": "Treat hasCapacity(options) as advisory, not as a reservation. Serialize create/remove decisions through one allocator; createTickingArea is authoritative and OverChunkLimit must requeue or fail according to policy.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ],
        "versions": {
          "scriptModule": "@minecraft/server",
          "scriptModuleVersion": "2.6.0"
        }
