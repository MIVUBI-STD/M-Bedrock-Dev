        "chunk-recovery",
        "capacity-race",
        "request-queue"
      ],
      "riskSurfaces": [
        "multiplayer-concurrency",
        "resource-limit"
      ]
    },
    {
      "id": "chunk-policy.tickingarea-error-specific-handling",
      "domain": "chunks",
      "subject": "tickingarea-error-routing",
      "statement": "Handle TickingAreaError reasons separately: IdentifierAlreadyExists triggers ownership reconciliation, OverChunkLimit triggers capacity handling, SideLengthExceeded is a planner/configuration failure, and UnknownIdentifier during cleanup is reconciled as stale lease state rather than blindly retried.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ],
        "versions": {
          "scriptModule": "@minecraft/server",
          "scriptModuleVersion": "2.6.0"
        }
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "chunk-recovery",
        "error-routing"
      ],
      "riskSurfaces": [
        "resource-limit",
        "lease-reconciliation"
      ]
    },
    {
      "id": "chunk-policy.tickingarea-restricted-deferral",
      "domain": "chunks",
      "subject": "tickingarea-execution-context",
      "statement": "A recovery request detected in restricted execution may be recorded there, but Script TickingAreaManager creation/removal must be deferred into default execution, for example through the system job queue.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ],
        "versions": {
          "scriptModule": "@minecraft/server",
