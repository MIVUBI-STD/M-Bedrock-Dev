        "idempotency"
      ],
      "riskSurfaces": [
        "entity-duplication",
        "entity-lifecycle"
      ]
    },
    {
      "id": "chunk-policy.minimal-recovery-footprint",
      "domain": "chunks",
      "subject": "recovery-footprint",
      "statement": "Temporary recovery should load the smallest chunk footprint required by the operation. Do not reuse the 4-chunk coverage envelope as the default ticking-area recovery radius; operation-specific margins must be explicit.",
      "classification": "project-policy",
      "applicability": {
