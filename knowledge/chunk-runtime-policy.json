        "state-identity"
      ]
    },
    {
      "id": "chunk-policy.persistence-profile-required",
      "domain": "chunks",
      "subject": "critical-entity-persistence-profile",
      "statement": "Every critical entity registry entry must classify the original entity definition as persistent, transient, despawn-capable, or unknown. A critical entity expected to survive unloaded periods must not be assumed recoverable if its behavior definition allows it to disappear.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "entity-registry",
        "entity-persistence"
      ],
      "riskSurfaces": [
        "entity-lifecycle"
      ],
      "diagnosticHints": [
        "CRITICAL_ENTITY_PERSISTENCE_CONTRACT_MISMATCH"
      ]
    },
    {
      "id": "chunk-policy.defer-nonpersistent-precreation",
      "domain": "chunks",
      "subject": "pre-game-entity-survivability",
      "statement": "If an entity is not guaranteed to survive the interval between setup coverage and actual gameplay activation, do not pre-create it merely because its chunk is temporarily loaded. Prefer validating its spawn source/configuration during setup and create it at gameplay activation when player/simulation conditions are correct.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
