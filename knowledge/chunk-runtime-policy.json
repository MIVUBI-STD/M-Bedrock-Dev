    {
      "id": "chunk-policy.do-not-cache-entity-handles-across-unload",
      "domain": "chunks",
      "subject": "entity-handle-lifetime",
      "statement": "Do not treat Entity object references as durable registry state across coverage changes or unload boundaries. Persist logical identity, engine id, type/tags, dimension, and last known location; reacquire the Entity handle when needed.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
