  "facts": [
    {
      "id": "chunk-policy.setup-original-target-registry",
      "domain": "chunks",
      "subject": "arena-setup-target-registry",
      "statement": "Before gameplay, build an explicit setup target registry from the original pack covering every entity, spawner, and location required by arena setup; original-pack coordinates and gameplay semantics remain authoritative.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "arena-setup",
        "chunk-coverage",
        "original-pack-preservation"
      ],
      "riskSurfaces": [
        "chunk-lifecycle",
        "entity-lifecycle",
        "load-order"
      ],
      "diagnosticHints": [
        "Missing registry coverage is a setup-plan error, not permission to silently skip the target."
      ]
    },
    {
      "id": "chunk-policy.coverage-initial-three",
      "domain": "chunks",
      "subject": "coverage-point-planner",
      "statement": "Plan three initial coverage points per arena/dimension from the distribution of original setup targets, then add deterministic extra points when required to cover outliers.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "arena-setup",
        "chunk-coverage"
      ],
      "riskSurfaces": [
        "chunk-lifecycle",
        "load-order"
      ]
    },
    {
      "id": "chunk-policy.coverage-radius-four",
      "domain": "chunks",
      "subject": "coverage-radius",
      "statement": "Use a maximum planning distance of 4 chunks from a coverage point to an assigned target, measured in chunk space; this is a project safety envelope and not proof that the target chunk is loaded.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "arena-setup",
        "chunk-coverage"
      ],
      "riskSurfaces": [
        "chunk-lifecycle"
      ],
      "diagnosticHints": [
        "Any uncovered target must create a new coverage point or fail planning explicitly."
      ]
    },
    {
      "id": "chunk-policy.coverage-per-dimension",
      "domain": "chunks",
      "subject": "coverage-dimension-isolation",
      "statement": "Coverage planning is dimension-local: targets from different dimensions must never share a coverage point or readiness result.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "arena-setup",
        "chunk-coverage"
      ],
      "riskSurfaces": [
        "chunk-lifecycle",
        "cross-dimension"
      ]
    },
    {
      "id": "chunk-policy.setup-player-loader-lease",
      "domain": "chunks",
      "subject": "loader-player-lease",
      "statement": "Normal arena setup uses a temporary loader-player lease: snapshot the chosen player's dimension, location, rotation, and game mode; switch to Spectator; teleport through coverage points; always restore the snapshot when setup ends or aborts.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "arena-setup",
        "player-driven-loading"
      ],
      "riskSurfaces": [
        "player-state",
        "chunk-lifecycle"
      ],
      "diagnosticHints": [
        "A disconnect or failed restore must produce an explicit setup failure/cleanup path."
      ]
    },
    {
      "id": "chunk-policy.setup-no-normal-tickingarea",
      "domain": "chunks",
      "subject": "arena-setup-loading-backend",
      "statement": "Normal pre-game arena setup must not create ticking areas; coverage loading is player-driven so the original arena is not kept persistently active.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "arena-setup",
        "player-driven-loading"
      ],
      "riskSurfaces": [
        "chunk-lifecycle",
        "resource-limit"
      ]
    },
    {
      "id": "chunk-policy.setup-readiness-evidence",
      "domain": "chunks",
      "subject": "coverage-readiness",
      "statement": "After teleporting the loader player, wait for explicit chunk-readiness evidence for every unique assigned target chunk; fixed tick delays alone are not sufficient readiness proof.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "arena-setup",
        "chunk-readiness"
      ],
      "riskSurfaces": [
        "load-order",
        "chunk-lifecycle"
      ],
      "diagnosticHints": [
        "Prefer Dimension.isChunkLoaded where the target Script API supports it; otherwise use a project-supported area-loaded readiness mechanism or fail closed."
      ]
    },
    {
      "id": "chunk-policy.setup-fail-closed",
      "domain": "chunks",
      "subject": "arena-setup-failure-semantics",
      "statement": "Coverage gaps, readiness timeouts, ambiguous entity resolution, missing critical targets, or player-state restore failures must be explicit setup failures; gameplay must not start with silently skipped setup targets.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "arena-setup",
        "fail-closed"
      ],
      "riskSurfaces": [
        "entity-lifecycle",
        "load-order",
        "gameplay-state"
      ],
      "diagnosticHints": [
        "ARENA_SETUP_COVERAGE_GAP",
        "ARENA_SETUP_CHUNK_TIMEOUT",
        "ARENA_SETUP_TARGET_MISSING",
        "ARENA_SETUP_TARGET_AMBIGUOUS",
        "ARENA_SETUP_RESTORE_FAILED"
      ]
    },
    {
      "id": "chunk-policy.setup-idempotent-ledger",
      "domain": "chunks",
      "subject": "arena-setup-ledger",
      "statement": "Every setup target must have an idempotent processing ledger keyed by arena setup session/generation so retries cannot double-apply initialization and stale async work cannot start gameplay.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "arena-setup",
        "idempotency"
      ],
      "riskSurfaces": [
        "gameplay-state",
        "multiplayer-concurrency"
      ]
    },
    {
      "id": "chunk-policy.setup-final-verification",
      "domain": "chunks",
      "subject": "arena-setup-completion",
      "statement": "Arena start is gated on final verification that every critical original-pack setup target is processed successfully and the loader player has been restored to the intended gameplay state.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "arena-setup",
