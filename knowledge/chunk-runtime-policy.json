        "event-order"
      ]
    },
    {
      "id": "chunk-policy.tickingarea-startup-reconciliation",
      "domain": "chunks",
      "subject": "tickingarea-orphan-reconciliation",
      "statement": "On manager initialization/reload, enumerate pack-owned Script ticking areas, compare them with the current generation/lease ledger, adopt still-valid leases, and remove stale namespaced leases. Never rely solely on in-memory lease state.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ],
        "versions": {
          "scriptModule": "@minecraft/server",
          "scriptModuleVersion": "2.6.0"
