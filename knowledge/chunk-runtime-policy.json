        "cross-pack-contention"
      ]
    },
    {
      "id": "chunk-policy.command-backend-capability-gate",
      "domain": "chunks",
      "subject": "command-tickingarea-availability",
      "statement": "Before selecting the /tickingarea fallback backend, prove the target environment permits the command. If required permissions/cheats are unavailable, report the recovery backend as unsupported instead of entering an infinite queue.",
      "classification": "project-policy",
      "applicability": {
