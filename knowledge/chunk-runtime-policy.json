    },
    {
      "id": "chunk-policy.recovery-coalesce-priority",
      "domain": "chunks",
      "subject": "chunk-recovery-scheduler",
      "statement": "Coalesce compatible requests for the same dimension/chunk region, prioritize critical persistent-entity recovery over non-critical work, preserve FIFO within priority, and use aging to prevent starvation.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
