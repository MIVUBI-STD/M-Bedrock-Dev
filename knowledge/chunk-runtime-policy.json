        "arena-setup",
        "chunk-readiness",
        "target-readiness"
      ],
      "riskSurfaces": [
        "load-order",
        "entity-lifecycle"
      ]
    },
    {
      "id": "chunk-policy.spectator-isolation-assumption",
      "domain": "chunks",
      "subject": "spectator-loader",
      "statement": "Spectator is an interaction-isolation choice, not a chunk-readiness guarantee. The setup system must remain correct if Spectator-specific loading behavior differs by target/runtime.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
