        "chunk-lifecycle"
      ],
      "diagnosticHints": [
        "CHUNK_RECOVERY_RETRY_FAILED"
      ]
    },
    {
      "id": "chunk-policy.coverage-bootstrap-precondition",
      "domain": "chunks",
      "subject": "coverage-anchor-bootstrap",
      "statement": "Before relocating the loader player, classify the coverage anchor as already loaded, bootstrap-required, or unsafe. Do not assume teleporting directly into an unloaded anchor will load it.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "arena-setup",
        "teleport-bootstrap"
      ],
      "riskSurfaces": [
        "chunk-lifecycle",
        "load-order"
      ],
      "diagnosticHints": [
        "ARENA_SETUP_BOOTSTRAP_REQUIRED",
        "ARENA_SETUP_TELEPORT_FAILED"
      ]
    },
    {
      "id": "chunk-policy.coverage-bootstrap-fallback",
      "domain": "chunks",
      "subject": "coverage-bootstrap-backend",
      "statement": "If an anchor chunk is not loaded and player relocation cannot bootstrap it deterministically, acquire the smallest temporary bootstrap loading lease available for that target environment, prove the anchor ready, teleport the loader, then release the bootstrap lease once player-driven readiness is established.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
      "capabilityTags": [
        "arena-setup",
        "temporary-tickingarea",
        "teleport-bootstrap"
      ],
      "riskSurfaces": [
        "chunk-lifecycle",
        "resource-limit"
      ],
      "diagnosticHints": [
        "This is an exceptional bootstrap fallback, not the normal arena-lifetime loading backend."
      ]
    },
    {
      "id": "chunk-policy.coverage-target-readiness-two-gate",
      "domain": "chunks",
      "subject": "target-readiness",
      "statement": "Use two readiness gates: first prove the target chunk loaded, then prove the target-specific entity/component/setup contract. Chunk readiness alone cannot complete a target ledger entry.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-chunk-runtime-policy-v1"
      ],
