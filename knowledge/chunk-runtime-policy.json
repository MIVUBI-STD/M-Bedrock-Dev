        "player-state"
      ]
    },
    {
      "id": "chunk-policy.coverage-drain-before-move",
      "domain": "chunks",
      "subject": "coverage-drain-barrier",
      "statement": "Before moving the loader away from a coverage point, all target operations for that coverage lease must reach a terminal ledger state and no unresolved async work may still depend on entity handles from that coverage area.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
