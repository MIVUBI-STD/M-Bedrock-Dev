    {
      "id": "chunk-policy.command-manager-ten-slot-queue",
      "domain": "chunks",
      "subject": "command-tickingarea-capacity",
      "statement": "For the /tickingarea compatibility backend, one central manager owns leases and queues new requests when the world-level 10-area command limit would be exceeded.",
