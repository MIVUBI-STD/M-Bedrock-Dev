      "confidence": "designed",
      "retrievedDate": "2026-09-23"
    }
  ],
  "facts": [
    {
      "id": "world-policy.mutation-is-transaction",
      "domain": "world-mutation",
      "subject": "arena world mutation",
      "statement": "Treat structure loads, fills, block writes, marker changes, and entity restoration as a generation-scoped world-mutation transaction with PREPARE, APPLY, VERIFY, COMMIT, and RECOVER/ABORT phases.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-mutation-policy-v1"
      ],
      "capabilityTags": [
        "transaction",
        "world-mutation"
      ],
      "riskSurfaces": [
        "partial-write",
        "stale-generation",
        "arena-corruption"
      ]
    },
    {
      "id": "world-policy.region-lock",
      "domain": "world-mutation",
      "subject": "mutation region ownership",
      "statement": "A world region that can be mutated by structure/fill/block operations must have one current arena-generation owner. Overlapping concurrent mutations from different operations or generations are rejected or serialized.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-mutation-policy-v1"
      ],
      "capabilityTags": [
        "region-lock",
        "arena-isolation"
      ],
      "riskSurfaces": [
        "concurrent-structure-load",
        "cross-arena-corruption"
      ]
    },
    {
      "id": "world-policy.prepare-chunk-coverage",
      "domain": "world-mutation",
      "subject": "mutation preparation",
      "statement": "PREPARE must prove destination chunk readiness/coverage for all required mutation bounds before direct block writes and before declaring structure placement safe for immediate dependent work.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-mutation-policy-v1"
      ],
      "capabilityTags": [
        "chunk-readiness",
        "mutation-bounds"
      ],
      "riskSurfaces": [
        "unloaded-chunk",
        "false-readiness"
      ]
    },
    {
      "id": "world-policy.structure-request-not-commit",
      "domain": "world-mutation",
      "subject": "structure placement request",
      "statement": "A successful structure-load command or StructureManager.place call is APPLY-stage evidence only. COMMIT requires post-placement verification of required blocks, markers, critical entities, and generation ownership.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-mutation-policy-v1"
      ],
      "capabilityTags": [
        "structure-load",
        "verification"
      ],
      "riskSurfaces": [
        "false-success",
        "queued-placement",
        "missing-marker"
      ]
    },
    {
      "id": "world-policy.entity-inclusion-declared",
      "domain": "world-mutation",
      "subject": "structure entity inclusion",
      "statement": "Every gameplay structure must explicitly declare whether entities are included. If entities are included, the transaction must define duplicate-detection and identity reconciliation before placement can commit.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-mutation-policy-v1"
      ],
      "capabilityTags": [
        "structure-entities",
        "entity-registry"
      ],
      "riskSurfaces": [
        "duplicate-entity",
        "identity-collision"
      ]
    },
    {
      "id": "world-policy.marker-contract",
      "domain": "world-mutation",
      "subject": "post-load marker verification",
      "statement": "Structures used for gameplay must expose a verification contract such as sentinel blocks, marker entities, expected block signatures, or region hashes so the analyzer can distinguish requested placement from verified placement.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-mutation-policy-v1"
      ],
      "capabilityTags": [
        "sentinel",
        "verification-contract"
      ],
      "riskSurfaces": [
        "silent-partial-load",
        "wrong-structure"
      ]
    },
    {
      "id": "world-policy.no-dependent-work-before-verify",
      "domain": "world-mutation",
      "subject": "dependent gameplay after mutation",
      "statement": "Spawns, teleports, pathfinding activation, arena start, scoring activation, and selector queries that depend on mutated world state must wait until VERIFY succeeds for the current mutation generation.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-mutation-policy-v1"
      ],
      "capabilityTags": [
        "readiness-gate",
        "dependent-work"
      ],
      "riskSurfaces": [
        "race-condition",
        "path-blocked",
        "spawn-failure"
      ]
    },
    {
      "id": "world-policy.rollback-is-compensation",
      "domain": "world-mutation",
      "subject": "world mutation rollback",
      "statement": "Do not assume Bedrock world mutation is inherently atomic. Recovery should use explicit compensating actions or a known baseline structure/snapshot, and recovery itself must be generation-scoped and verified.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-mutation-policy-v1"
      ],
      "capabilityTags": [
        "rollback",
        "compensation"
      ],
      "riskSurfaces": [
        "partial-write",
        "failed-rollback",
        "state-corruption"
      ]
    },
    {
      "id": "world-policy.stale-mutation-cancel",
      "domain": "world-mutation",
      "subject": "stale generation mutation",
      "statement": "After any await/deferred callback and before APPLY/VERIFY/COMMIT/RECOVER work, revalidate arenaGeneration and mutationGeneration. Old generations must never mutate or repair a newer round.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-mutation-policy-v1"
      ],
      "capabilityTags": [
        "generation-token",
        "stale-mutation"
      ],
      "riskSurfaces": [
        "cross-round-state",
        "stale-callback"
      ]
    },
    {
      "id": "world-policy.transform-aware-bounds",
      "domain": "world-mutation",
      "subject": "rotation and mirror bounds",
      "statement": "Mutation bounds, sentinel locations, path checks, and overlap locks must be computed after applying structure rotation/mirror transforms, not from untransformed source coordinates.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-mutation-policy-v1"
      ],
      "capabilityTags": [
        "rotation",
        "mirror",
        "bounds"
      ],
      "riskSurfaces": [
        "wrong-bounds",
        "region-overlap",
        "missing-sentinel"
      ]
    },
    {
      "id": "world-policy.animated-structure-not-immediate",
      "domain": "world-mutation",
      "subject": "animated structure load",
      "statement": "If structure animation is enabled, the transaction must remain APPLYING until animation completion plus verification; gameplay must not treat command return as a completed load.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-world-mutation-policy-v1"
      ],
      "capabilityTags": [
        "structure-animation",
        "transaction-phase"
      ],
      "riskSurfaces": [
        "early-start",
        "partial-world-state"
      ]
    }
  ],
