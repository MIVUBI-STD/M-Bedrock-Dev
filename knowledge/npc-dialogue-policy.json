        "npc"
      ],
      "riskSurfaces": [
        "global-selector",
        "wrong-player"
      ]
    },
    {
      "id": "npc-policy.no-dual-form-authority",
      "domain": "npc-dialogue",
      "subject": "dialogue vs script form",
      "statement": "NPC dialogue and script UI forms must not independently own the same gameplay transaction without arbitration; duplicate button/form paths require one operation token.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
