      "id": "npc-policy.session-envelope",
      "domain": "npc-dialogue",
      "subject": "dialogue session",
      "statement": "Gameplay dialogue must capture player session generation, npc entity generation, arenaGeneration, dialogueGeneration, scene tag, and purpose; button/close actions revalidate this envelope before side effects.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
