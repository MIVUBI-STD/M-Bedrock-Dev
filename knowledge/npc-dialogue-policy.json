        "idempotency"
      ],
      "riskSurfaces": [
        "double-submit"
      ]
    },
    {
      "id": "npc-policy.reset-invalidates",
      "domain": "npc-dialogue",
      "subject": "arena reset",
      "statement": "Arena reset/disconnect invalidates dialogue sessions and their pending logical actions. NPCs restored by structures are re-registered before reuse.",
      "classification": "project-policy",
