        "generation-token"
      ],
      "riskSurfaces": [
        "stale-dialogue",
        "cross-round-action"
      ]
    },
    {
      "id": "npc-policy.commands-scope",
      "domain": "npc-dialogue",
      "subject": "NPC command",
      "statement": "Commands embedded in dialogue are analyzed like any other command surface: executor/origin assumptions, selector scope, cardinality, arena ownership, and generation must be explicit for critical actions.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-npc-policy-v1"
      ],
