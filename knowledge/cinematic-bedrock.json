      "id": "cinematic.camera-state-persists-until-clear-or-disconnect",
      "domain": "cinematic",
      "subject": "camera state",
      "statement": "A camera preset applied to a player persists until explicitly cleared or the player disconnects, so camera state is a per-player runtime resource that requires lifecycle cleanup.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-camera-system"
      ],
      "capabilityTags": [
        "camera",
        "lifecycle"
      ],
      "riskSurfaces": [
        "camera-leak",
        "disconnect",
        "cutscene-residue"
      ]
    },
    {
      "id": "cinematic.camera-set-clear-fade-target-player",
      "domain": "cinematic",
      "subject": "camera command targeting",
      "statement": "Camera commands target selected players and support set, clear, fade, target attachment, FOV, easing, and facing operations, so cinematic state is player-targeted rather than inherently global.",
