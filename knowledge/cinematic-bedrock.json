      "id": "cinematic.camera-methods-restricted-execution",
      "domain": "cinematic",
      "subject": "Camera API execution privilege",
      "statement": "Camera clear/fade/set methods cannot be called from restricted-execution mode and may throw, so cutscene control must run in a valid execution phase and handle failure.",
      "classification": "engine-fact",
      "applicability": {
