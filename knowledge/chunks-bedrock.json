    {
      "id": "chunks.tickingarea-manager-error-reasons",
      "domain": "chunks",
      "subject": "TickingAreaErrorReason",
      "statement": "TickingAreaManager can report IdentifierAlreadyExists, OverChunkLimit, SideLengthExceeded, and UnknownIdentifier; these errors represent different recovery actions and must not share one generic retry path.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ],
        "versions": {
          "scriptModule": "@minecraft/server",
          "scriptModuleVersion": "2.6.0"
        }
      },
      "sourceIds": [
        "ms-chunks-tickingarea-errors"
      ],
      "capabilityTags": [
        "script-tickingarea-manager",
        "chunk-recovery-errors"
      ],
      "riskSurfaces": [
        "resource-limit",
        "chunk-lifecycle"
      ],
      "diagnosticHints": [
        "IdentifierAlreadyExists requires ownership/reconciliation.",
        "OverChunkLimit is capacity pressure and may be queued.",
        "SideLengthExceeded is an invalid request shape and must not be queued forever.",
        "UnknownIdentifier during cleanup may indicate stale local lease state."
      ]
