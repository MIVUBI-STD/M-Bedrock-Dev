        "chunk-lifecycle"
      ]
    },
    {
      "id": "chunks.chunk-size-horizontal",
      "domain": "chunks",
      "subject": "chunk-coordinate-system",
      "statement": "A Minecraft chunk is 16 blocks wide by 16 blocks long, so chunk-space X/Z can be derived from block coordinates using floor(x/16) and floor(z/16).",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-tickingarea-guide"
      ],
      "capabilityTags": [
        "chunk-lifecycle",
        "chunk-coordinate"
      ],
      "riskSurfaces": [
        "chunk-lifecycle"
      ]
    },
    {
      "id": "chunks.player-simulation-distance-configurable",
      "domain": "chunks",
      "subject": "player-simulation-distance",
      "statement": "Simulation distance is measured from players in chunks; the documented default is 4 chunks and supported values may be higher, up to 12 depending on device/runtime.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-simulation-ticking"
      ],
      "capabilityTags": [
        "chunk-lifecycle",
        "player-driven-loading"
      ],
      "riskSurfaces": [
        "chunk-lifecycle",
        "entity-ai",
        "load-order"
      ],
      "diagnosticHints": [
        "Do not treat a project planning radius of 4 chunks as proof that every target chunk is already loaded; verify readiness explicitly."
      ]
    },
