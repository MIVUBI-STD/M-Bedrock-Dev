      "id": "chunks.spawn-entity-unloaded-chunk-error",
      "domain": "chunks",
      "subject": "Dimension.spawnEntity",
      "statement": "Dimension.spawnEntity can throw LocationInUnloadedChunkError when the target location is in an unloaded chunk.",
