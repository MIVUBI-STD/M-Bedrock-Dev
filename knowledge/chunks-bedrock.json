      "id": "chunks.simulation-distance-ticks",
      "domain": "chunks",
      "subject": "simulation-distance",
      "statement": "Gameplay systems that require ticking are generally active around players within simulation distance; outside it, many tick-driven systems stop updating.",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-simulation-ticking",
        "ms-tickingarea-guide"
      ],
      "capabilityTags": [
        "chunk-lifecycle"
      ],
      "riskSurfaces": [
        "chunk-lifecycle",
        "entity-ai",
        "command-block-runtime"
      ]
    },
