      "riskSurfaces": [
        "resource-limit",
        "chunk-lifecycle"
      ],
      "diagnosticHints": [
        "Use manager.maxChunkCount/hasCapacity for Script API capacity; do not apply the command 10-area limit to this backend."
      ]
    },
