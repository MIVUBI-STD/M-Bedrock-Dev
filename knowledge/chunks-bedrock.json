      "id": "chunks.tickingarea-limits",
      "domain": "chunks",
      "subject": "tickingarea-limits",
      "statement": "A world can have up to 10 ticking areas; documented ticking areas may contain up to 100 chunks, and circle radius is limited to 0–4 chunks.",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
