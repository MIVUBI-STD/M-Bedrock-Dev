        "load-order"
      ],
      "diagnosticHints": [
        "A player-driven coverage planner needs an explicit bootstrap path for an unloaded destination chunk."
      ]
    },
    {
      "id": "chunks.tickingarea-does-not-create-player-spawn-context",
      "domain": "chunks",
      "subject": "tickingarea-player-presence",
      "statement": "Ticking areas keep chunks active without nearby players, but mobs do not spawn there unless a player is present within simulation distance.",
