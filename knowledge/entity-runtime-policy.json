  ],
  "facts": [
    {
      "id": "ai-policy.ai-stack-contract",
      "domain": "entity-runtime",
      "subject": "gameplay entity AI stack",
      "statement": "Every path-dependent gameplay entity must declare a runtime AI stack contract covering movement component, navigation component, target acquisition, movement/attack goals, relevant goal priorities/control flags, and required environmental capabilities.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-entity-runtime-policy-v1"
      ],
      "capabilityTags": [
        "ai-stack",
        "contract"
      ],
      "riskSurfaces": [
        "stationary-entity",
        "goal-conflict"
      ]
    },
    {
      "id": "ai-policy.spawn-nav-preflight",
      "domain": "entity-runtime",
      "subject": "entity spawn location",
      "statement": "Before spawning path-dependent entities, validate that the spawn location belongs to a navigable/supportable area for that entity's navigation type and is connected to at least one intended route/objective region where feasible.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-entity-runtime-policy-v1"
      ],
      "capabilityTags": [
        "spawn",
        "navigation"
      ],
      "riskSurfaces": [
        "spawn-stuck",
        "isolated-nav-island"
      ]
    },
    {
      "id": "ai-policy.target-proof",
      "domain": "entity-runtime",
      "subject": "target-driven AI",
      "statement": "For target-driven entities, analyzer should distinguish NO_TARGET from PATH_UNREACHABLE and GOAL_NOT_RUNNING. A stationary entity must not be diagnosed as pathfinding failure until target acquisition and goal arbitration are verified.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-entity-runtime-policy-v1"
      ],
      "capabilityTags": [
        "target",
        "diagnosis"
      ],
      "riskSurfaces": [
        "false-pathfinding-diagnosis"
      ]
    },
    {
      "id": "ai-policy.progress-watchdog",
      "domain": "entity-runtime",
      "subject": "navigation progress",
      "statement": "Critical moving entities should be observed with bounded progress evidence such as displacement toward objective, waypoint advancement, or distance reduction over a configured window; lack of progress transitions to STALLED_CANDIDATE rather than immediately teleporting.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-entity-runtime-policy-v1"
      ],
      "capabilityTags": [
        "progress",
        "stuck-detection"
      ],
      "riskSurfaces": [
        "stuck-entity",
        "false-positive"
      ]
    },
    {
      "id": "ai-policy.stall-state-machine",
      "domain": "entity-runtime",
      "subject": "stuck recovery",
      "statement": "Model navigation recovery as MOVING, STALLED_CANDIDATE, REPATHING, RECOVERY_MOVE, TELEPORT_FALLBACK, and TERMINAL_STUCK. Each escalation requires stronger evidence and bounded retry counts.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-entity-runtime-policy-v1"
      ],
      "capabilityTags": [
        "stuck-recovery",
        "state-machine"
      ],
      "riskSurfaces": [
        "teleport-loop",
        "recovery-storm"
      ]
    },
    {
      "id": "ai-policy.no-immediate-teleport-on-stall",
      "domain": "entity-runtime",
      "subject": "stuck fallback",
      "statement": "Do not teleport an entity merely because velocity/displacement is temporarily low. First verify target presence, goal validity, navigation environment, obstruction/world mutation state, and recovery budget.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-entity-runtime-policy-v1"
      ],
      "capabilityTags": [
        "stuck",
        "teleport-fallback"
      ],
      "riskSurfaces": [
        "false-recovery",
        "entity-jump"
      ]
    },
    {
      "id": "ai-policy.path-invalidated-by-world-mutation",
      "domain": "entity-runtime",
      "subject": "world mutation path invalidation",
      "statement": "After structure load, fill/setblock, door/gate state changes, bridge changes, or other route-affecting world mutation, invalidate prior route assumptions and reverify path-critical regions before blaming the entity AI.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-entity-runtime-policy-v1"
      ],
      "capabilityTags": [
        "world-mutation",
        "path-revalidation"
      ],
      "riskSurfaces": [
        "stale-path-assumption",
        "blocked-route"
      ]
    },
    {
      "id": "ai-policy.route-corridor-contract",
      "domain": "entity-runtime",
      "subject": "designed gameplay route",
      "statement": "For authored arena paths such as bridges, gates, lanes, and corridors, define route corridor contracts including passable width/height, support blocks, jump/drop limits, forbidden hazards, gate states, and expected entry/exit anchors.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-entity-runtime-policy-v1"
      ],
      "capabilityTags": [
        "route-corridor",
        "arena-path"
      ],
      "riskSurfaces": [
        "bridge-stuck",
        "gate-blocked",
        "geometry-regression"
      ]
    },
    {
      "id": "ai-policy.multi-entity-congestion",
      "domain": "entity-runtime",
      "subject": "crowd pathing",
      "statement": "Analyzer should consider entity-entity congestion separately from static path obstruction. A route usable by one mob may deadlock or bottleneck when many entities occupy a narrow corridor simultaneously.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-entity-runtime-policy-v1"
      ],
      "capabilityTags": [
        "crowd",
        "congestion"
      ],
      "riskSurfaces": [
        "mob-jam",
        "bridge-bottleneck"
      ]
    },
    {
      "id": "ai-policy.goal-priority-audit",
      "domain": "entity-runtime",
      "subject": "AI goal arbitration",
      "statement": "Audit movement/attack goals for priority and control-flag conflicts; a path can exist and target can be valid while another higher-priority goal owns move/look/jump control.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-entity-runtime-policy-v1"
      ],
      "capabilityTags": [
        "ai-priority",
        "control-flags"
      ],
      "riskSurfaces": [
        "goal-starvation",
        "stationary-entity"
      ]
    },
    {
      "id": "ai-policy.nav-capability-environment-match",
      "domain": "entity-runtime",
      "subject": "navigation environment compatibility",
      "statement": "Compare navigation capabilities against actual route materials and topology: water, doors, climb, jumps, drops, damaging blocks, portals, and blocks_to_avoid. An unreachable route caused by capability mismatch is not a generic AI failure.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-entity-runtime-policy-v1"
      ],
      "capabilityTags": [
        "navigation-capability",
        "environment"
      ],
      "riskSurfaces": [
        "unreachable-path",
        "wrong-nav-type"
      ]
    },
    {
      "id": "ai-policy.recovery-generation-bound",
      "domain": "entity-runtime",
      "subject": "AI recovery ownership",
      "statement": "Stuck detection and recovery callbacks must be bound to entity identity/residency, arenaGeneration, entityGeneration, routeGeneration, and recoveryGeneration so stale recovery cannot move a replaced or newer-round entity.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-entity-runtime-policy-v1"
      ],
      "capabilityTags": [
        "generation-token",
        "recovery"
      ],
      "riskSurfaces": [
        "stale-teleport",
        "cross-round-state"
      ]
    },
    {
      "id": "ai-policy.performance-cap",
      "domain": "entity-runtime",
      "subject": "AI path monitoring budget",
      "statement": "Progress checks, route probes, and recovery scans must obey per-arena/global performance budgets and should prefer targeted registries over scanning every mob every tick.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-entity-runtime-policy-v1"
      ],
      "capabilityTags": [
        "performance",
        "path-monitor"
      ],
      "riskSurfaces": [
        "query-fanout",
        "watchdog"
      ]
    }
  ],
