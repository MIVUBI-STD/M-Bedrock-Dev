      "id": "spatial.dimension-height-range-runtime",
      "domain": "spatial-containment",
      "subject": "Dimension.heightRange",
      "statement": "Each dimension exposes a heightRange defining valid vertical bounds; spatial validation must use the actual dimension range rather than hard-coded universal Y limits.",
      "classification": "engine-fact",
      "applicability": {
