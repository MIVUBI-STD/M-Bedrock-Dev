        "void-recovery"
      ]
    },
    {
      "id": "spatial.dimensionlocation-binds-coordinates",
      "domain": "spatial-containment",
      "subject": "DimensionLocation",
      "statement": "A world location is identified by both its coordinates and its Dimension; identical x/y/z values in different dimensions represent different spatial locations.",
