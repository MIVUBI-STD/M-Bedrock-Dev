      "id": "spatial.teleport-can-change-dimension",
      "domain": "spatial-containment",
      "subject": "TeleportOptions.dimension",
      "statement": "Teleport can move entities between dimensions and can optionally preserve velocity or check block collision, so containment transitions can change both dimension membership and motion state.",
