    {
      "id": "interaction.form-show-async",
      "domain": "interaction",
      "subject": "server-ui form show",
      "statement": "ActionFormData.show and ModalFormData.show return Promises that resolve later when the player confirms or cancels, so response handling is a deferred callback path rather than an immediate transaction.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-ui-action-form",
        "ms-ui-modal-form"
      ],
      "capabilityTags": [
        "server-ui",
        "async-form"
      ],
      "riskSurfaces": [
        "stale-response",
        "disconnect",
        "generation-change"
      ]
    },
    {
      "id": "interaction.form-show-restricted-illegal",
      "domain": "interaction",
      "subject": "form show execution privilege",
      "statement": "Form show methods cannot be called from restricted-execution mode and can throw engine/entity/message errors.",
      "classification": "engine-fact",
