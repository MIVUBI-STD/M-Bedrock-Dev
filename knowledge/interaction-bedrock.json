    {
      "id": "interaction.block-interact-can-repeat-while-held",
      "domain": "interaction",
      "subject": "playerInteractWithBlock",
      "statement": "playerInteractWithBlock includes isFirstEvent, which is true for the initial interaction press and false for repeated events from holding the interaction input; treating every event as a unique button press can duplicate actions.",
