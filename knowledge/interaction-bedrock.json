    {
      "id": "interaction.entity-interact-exposes-before-after-item",
      "domain": "interaction",
      "subject": "playerInteractWithEntity",
      "statement": "Entity interaction after-events expose the source player, target entity, and item stack before/after the successful interaction, so gameplay can validate both actor/target identity and item-side effects.",
