      "riskSurfaces": [
        "undefined-selection",
        "false-submit"
      ]
    },
    {
      "id": "interaction.input-permissions-mutable",
      "domain": "interaction",
      "subject": "PlayerInputPermissions",
      "statement": "Player input permission categories can be queried and enabled or disabled through PlayerInputPermissions; mutating these permissions is not allowed in restricted-execution mode and may throw errors.",
      "classification": "engine-fact",
      "applicability": {
