    {
      "id": "interaction.form-response-can-cancel",
      "domain": "interaction",
      "subject": "form response",
      "statement": "Form responses can represent cancellation and optional selection/value data, so canceled/absent values must be handled separately from successful user choice.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
