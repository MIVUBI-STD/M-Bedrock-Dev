    {
      "id": "interaction.input-permission-change-observable",
      "domain": "interaction",
      "subject": "playerInputPermissionCategoryChange",
      "statement": "World after-events expose player input-permission category changes, so control-lock changes are observable independently from the gameplay state that requested them.",
