{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M-Bedrock-Dev Game Design Specification",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "status",
    "source",
    "mechanics",
    "invariants"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "mapId": {
          "type": "string"
        },
        "modeId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "authored-spec",
            "client-brief",
            "approved-reconstruction"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "mechanics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "strength"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "strength": {
            "enum": [
              "must",
              "must-not",
              "should"
            ]
          },
          "subjectIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "behaviorConstraints": {
      "type": "object",
      "properties": {
        "combat": {
          "type": "object",
          "properties": {
            "friendlyFireAllowed": {
              "type": "boolean"
            },
            "crossArenaDamageAllowed": {
              "type": "boolean"
            },
            "environmentalDamageAllowed": {
              "type": "boolean"
            },
            "selfReviveAllowed": {
              "type": "boolean"
            },
            "multipleReviversAllowed": {
              "type": "boolean"
            },
            "reviveAfterDeathAllowed": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "economy": {
          "type": "object",
          "properties": {
            "deathRewardArbitration": {
              "enum": [
                "complementary",
                "mutually-exclusive",
                "unresolved"
              ]
            },
            "pickupCurrencyItemPolicy": {
              "enum": [
                "consume",
                "retain",
                "not-applicable"
              ]
            },
            "inventoryFullPolicy": {
              "enum": [
                "leave-remainder",
                "defer",
                "convert",
                "reject",
                "compensate",
                "not-applicable"
              ]
            }
          },
          "additionalProperties": false
        },
        "inventory": {
          "type": "object",
          "required": [
            "rules"
          ],
          "properties": {
            "rules": {
              "type": "array"
            }
          },
          "additionalProperties": false
        },
        "spatial": {
          "type": "object",
          "required": [
            "rules"
          ],
          "properties": {
            "rules": {
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": [
        "mapType",
        "playerMode",
        "mechanicTags",
        "classificationStatus",
        "evidenceRefs"
      ],
      "properties": {
        "mapType": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "BUILDING",
            "COMBAT",
            "SURVIVAL",
            "STRATEGY",
            "SEARCH_PUZZLE",
            "CHALLENGE_COURSE",
            "SKILL_COURSE",
            null
          ]
        },
        "playerMode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "SOLO",
            "COOPERATIVE",
            "COMPETITIVE",
            "TEAM_COMPETITIVE",
            "ASYMMETRIC",
            null
          ]
        },
        "mechanicTags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "BUILD",
              "MEMORY",
              "SEARCH",
              "PUZZLE",
              "PARKOUR",
              "MELEE_COMBAT",
              "RANGED_COMBAT",
              "TEAM_COMBAT",
              "BASE_DEFENSE",
              "BASE_ATTACK",
              "CAPTURE_OBJECTIVE",
              "ESCORT",
              "EXTRACTION",
              "WAVE_DEFENSE",
              "SURVIVAL_TIMER",
              "ENTITY_AI",
              "RESOURCE_ECONOMY",
              "SHOP",
              "LOADOUT",
              "CRAFTING",
              "COLLECTION",
              "RESPAWN",
              "REVIVE",
              "ROUND_TIMER",
              "MULTI_ARENA",
              "MULTI_STAGE",
              "PROGRESSION",
              "PERSISTENCE",
              "RECONNECT",
              "WORLD_RESET"
            ]
          }
        },
        "classificationStatus": {
          "enum": [
            "RESOLVED",
            "UNRESOLVED"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classificationStatus": {
                "const": "RESOLVED"
              }
            },
            "required": [
              "classificationStatus"
            ]
          },
          "then": {
            "properties": {
              "mapType": {
                "type": "string"
              },
              "playerMode": {
                "type": "string"
              },
              "evidenceRefs": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
