{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m-bedrock-bug-report/v1",
  "title": "M-Bedrock Bug Report V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "map", "bugFinders"],
  "properties": {
    "schema": {
      "const": "m-bedrock-bug-report/v1"
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "minecraftVersion", "drive"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "minecraftVersion": { "type": "string", "minLength": 1 },
        "drive": {
          "type": "string",
          "pattern": "^https://drive\\.google\\.com/"
        }
      }
    },
    "bugFinders": {
      "type": "array",
      "items": { "$ref": "#/$defs/bugFinder" }
    }
  },
  "$defs": {
    "bugFinder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "bugs"],
      "properties": {
        "category": {
          "enum": [
            "game-flow",
            "player-state",
            "multiplayer-session",
            "world-interaction",
            "entity-behavior",
            "combat",
            "score-reward",
            "ui-feedback",
            "performance-stability",
            "compatibility"
          ]
        },
        "bugs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bug" }
        }
      }
    },
    "bug": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "severity",
        "foundBy",
        "verification",
        "problem",
        "expected",
        "observed"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["blocker", "major", "minor"] },
        "foundBy": { "enum": ["ai", "tester", "ai+tester"] },
        "verification": { "enum": ["candidate", "observed", "verified"] },
        "problem": { "type": "string", "minLength": 1 },
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "reproduction": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "reproducibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempts", "reproduced"],
          "properties": {
            "attempts": { "type": "integer", "minimum": 1 },
            "reproduced": { "type": "integer", "minimum": 0 }
          }
        },
        "expected": { "type": "string", "minLength": 1 },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gameplay": { "type": "string", "minLength": 1 },
            "code": { "type": "string", "minLength": 1 }
          },
          "anyOf": [
            { "required": ["gameplay"] },
            { "required": ["code"] }
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "drive"],
            "properties": {
              "description": { "type": "string", "minLength": 1 },
              "drive": {
                "type": "string",
                "pattern": "^https://drive\\.google\\.com/"
              }
            }
          }
        },
        "verifyBug": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "codeFlow": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "diagnosis": { "type": "string", "minLength": 1 },
        "rootCause": { "type": "string", "minLength": 1 },
        "relevantCode": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "reason"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "lines": { "type": "string", "minLength": 1 }
            }
          }
        },
        "repairDirection": { "type": "string", "minLength": 1 },
        "mustPreserve": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "fixValidation": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "runtimeConditions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "players": { "type": "integer", "minimum": 1 },
            "activeArenas": { "type": "integer", "minimum": 1 },
            "condition": { "type": "string", "minLength": 1 },
            "server": { "type": "string", "minLength": 1 },
            "mode": { "type": "string", "minLength": 1 }
          },
          "minProperties": 1
        }
      }
    }
  }
}
