        "reward-count"
      ]
    },
    {
      "id": "loot.entity-death-table",
      "domain": "loot-economy",
      "subject": "minecraft:loot",
      "statement": "The minecraft:loot entity component assigns a loot table used when the entity dies, creating an engine-driven reward path independent of any scripted reward handler.",
