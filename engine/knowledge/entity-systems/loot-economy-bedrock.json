      "id": "loot.table-multipool-conditional",
      "domain": "loot-economy",
      "subject": "loot tables",
      "statement": "Loot tables can contain multiple independently rolled pools, weighted entries, bonus rolls, and conditions, so one source event may legitimately generate multiple items and outcomes.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
