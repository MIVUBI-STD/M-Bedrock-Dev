    {
      "id": "loot.command-can-spawn-or-inject",
      "domain": "loot-economy",
      "subject": "/loot",
      "statement": "The loot command can spawn loot into the world or place loot into inventories/entities, providing reward paths distinct from natural death drops and direct scripted inventory grants.",
      "classification": "engine-fact",
      "applicability": {
