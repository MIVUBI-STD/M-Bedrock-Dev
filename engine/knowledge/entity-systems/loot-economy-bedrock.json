      ]
    },
    {
      "id": "loot.spawn-requires-loaded-location",
      "domain": "loot-economy",
      "subject": "/loot spawn",
      "statement": "Loot spawning into the world can fail if the target position is outside the world or not loaded, so reward generation success depends on spatial readiness.",
