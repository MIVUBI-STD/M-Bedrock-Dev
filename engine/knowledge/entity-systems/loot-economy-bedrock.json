      "id": "loot.before-pickup-restricted-mutation",
      "domain": "loot-economy",
      "subject": "pickup before-event",
      "statement": "World before-events can fire before item pickup, but gameplay-state mutation is restricted in before-event listeners, so cancellation/inspection paths and post-pickup mutation paths have different execution privileges.",
