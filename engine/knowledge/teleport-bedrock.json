      ]
    },
    {
      "id": "teleport.spawnpoint-is-separate-from-teleport",
      "domain": "teleport",
      "subject": "Player.setSpawnPoint",
      "statement": "Player.setSpawnPoint configures a player's future spawn point and is a distinct operation from teleporting the player immediately.",
      "classification": "engine-fact",
