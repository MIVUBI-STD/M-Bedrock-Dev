    {
      "id": "teleport.tryteleport-can-fail",
      "domain": "teleport",
      "subject": "Entity.tryTeleport",
      "statement": "Entity.tryTeleport returns whether teleport succeeded and may fail when the destination chunk is unloaded or when the destination would intersect blocks.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-entity-teleport"
      ],
      "capabilityTags": [
        "tryTeleport",
        "collision",
        "chunk-readiness"
      ],
      "riskSurfaces": [
        "failed-teleport",
        "unloaded-chunk",
        "block-collision"
      ]
    },
    {
      "id": "teleport.options-check-for-blocks",
      "domain": "teleport",
      "subject": "TeleportOptions.checkForBlocks",
      "statement": "TeleportOptions can request block-obstruction checking at the destination, making collision policy an explicit part of teleport semantics rather than an automatic guarantee for every teleport path.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-teleport-options"
      ],
      "capabilityTags": [
        "teleport",
        "collision-check"
      ],
      "riskSurfaces": [
        "unsafe-destination",
        "inside-block"
      ]
    },
    {
      "id": "teleport.options-dimension",
      "domain": "teleport",
      "subject": "TeleportOptions.dimension",
      "statement": "TeleportOptions can move an entity to another dimension; if dimension is omitted, teleport occurs within the entity's current dimension.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-teleport-options"
      ],
      "capabilityTags": [
        "teleport",
        "dimension-transfer"
      ],
      "riskSurfaces": [
        "wrong-dimension",
        "cross-dimension-state"
      ]
    },
    {
      "id": "teleport.teleport-can-throw",
      "domain": "teleport",
      "subject": "Entity.teleport",
      "statement": "Entity.teleport can throw when the entity is invalid or functionality is unsupported and cannot be called from restricted execution, so a teleport call is not an infallible state transition.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-entity-teleport"
      ],
      "capabilityTags": [
        "teleport",
        "error"
      ],
      "riskSurfaces": [
        "partial-transition",
        "invalid-entity"
      ]
    },
    {
      "id": "teleport.spawn-entity-unloaded-chunk-error",
      "domain": "teleport",
      "subject": "Dimension.spawnEntity",
      "statement": "Dimension.spawnEntity can throw LocationInUnloadedChunkError and LocationOutOfWorldBoundariesError, so entity spawning requires both spatial validity and chunk readiness.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
