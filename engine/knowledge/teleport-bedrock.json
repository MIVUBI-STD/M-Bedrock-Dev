      "id": "teleport.dimensionlocation-binds-dimension-and-position",
      "domain": "teleport",
      "subject": "DimensionLocation",
      "statement": "DimensionLocation combines coordinates with a specific Dimension, so cross-dimension destination identity should be modeled as dimension plus position rather than position alone.",
