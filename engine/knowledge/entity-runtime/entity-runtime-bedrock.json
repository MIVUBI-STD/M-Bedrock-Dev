      "id": "ai.search-cost-can-scale",
      "domain": "entity-runtime",
      "subject": "AI search parameters",
      "statement": "Some AI goals perform repeated block searches per tick and expose search_count/range parameters; high search counts or wide search areas can increase per-entity work and become significant at scale.",
