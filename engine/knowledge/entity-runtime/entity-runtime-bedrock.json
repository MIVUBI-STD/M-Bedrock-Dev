        "navigation"
      ],
      "riskSurfaces": [
        "stationary-entity",
        "component-missing"
      ]
    },
    {
      "id": "ai.navigation-generic-capability-flags",
      "domain": "entity-runtime",
      "subject": "minecraft:navigation.generic",
      "statement": "navigation.generic path generation is governed by capability/avoidance settings such as walking, swimming, climbing, jumping, avoiding water, avoiding damage blocks, portals, and explicit blocks_to_avoid.",
      "classification": "engine-fact",
      "applicability": {
