    {
      "id": "ai.target-acquisition-separate-goal",
      "domain": "entity-runtime",
      "subject": "target acquisition",
      "statement": "Target acquisition behaviors such as nearest_attackable_target are separate from movement/attack behaviors, so a complete hostile AI stack must establish both a valid target and a compatible pursue/attack behavior.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
