    {
      "id": "ai.move-target-requires-target",
      "domain": "entity-runtime",
      "subject": "minecraft:behavior.move_towards_target",
      "statement": "move_towards_target requires the entity to already have a current target; movement logic can be valid while the entity remains stationary because target acquisition never succeeded.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-ai-move-target"
      ],
      "capabilityTags": [
        "ai-goal",
        "target"
      ],
      "riskSurfaces": [
        "no-target",
        "stationary-entity"
      ]
    },
    {
      "id": "ai.goal-priority-lower-number-higher",
      "domain": "entity-runtime",
      "subject": "AI goal priority",
      "statement": "AI goal priority increases as the numeric priority approaches zero, so competing behaviors can prevent a movement/attack goal from running even when its configuration is otherwise valid.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-ai-move-target",
        "ms-ai-components-guide"
      ],
      "capabilityTags": [
        "ai-priority",
        "goal-arbitration"
      ],
      "riskSurfaces": [
        "goal-starvation",
        "behavior-conflict"
      ]
    },
    {
      "id": "ai.control-flags-compete",
      "domain": "entity-runtime",
      "subject": "AI control flags",
      "statement": "AI goals can claim control flags such as move, look, and jump; incompatible active goals can therefore contend for movement-related control and alter which behavior actually executes.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-ai-move-target"
      ],
      "capabilityTags": [
        "control-flags",
        "goal-arbitration"
      ],
      "riskSurfaces": [
        "movement-conflict",
        "goal-starvation"
      ]
    },
    {
      "id": "ai.navigation-requires-navigation-component",
      "domain": "entity-runtime",
      "subject": "navigation stack",
      "statement": "Entities need compatible movement and navigation components to move through the world; missing movement or navigation components is a documented cause of entities spawning but standing still.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
