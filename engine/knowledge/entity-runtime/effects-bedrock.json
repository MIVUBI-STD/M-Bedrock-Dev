      ],
      "capabilityTags": [
        "component-group",
        "reinitialize"
      ],
      "riskSurfaces": [
        "timer-restart",
        "duplicate-transition"
      ]
    },
    {
      "id": "effects.event-mutation-delayed-until-entity-tick",
      "domain": "effects",
      "subject": "entity event mutation",
      "statement": "Entity-event property and component-group mutations are calculated when the event is received but applied later when the entity ticks; same-tick reads or subsequent events may not observe the queued mutation yet.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-effects-entity-properties"
      ],
      "capabilityTags": [
        "entity-event",
        "delayed-apply"
      ],
      "riskSurfaces": [
        "same-tick-read-after-write",
        "stale-property-read"
      ]
    },
    {
      "id": "effects.property-and-component-group-batched",
      "domain": "effects",
      "subject": "entity property mutation queue",
      "statement": "Property changes and add/remove component-group changes can be queued together and applied later, so intermediate same-tick state is not necessarily globally observable.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
