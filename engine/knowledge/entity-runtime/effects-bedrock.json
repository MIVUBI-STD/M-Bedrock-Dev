    {
      "id": "effects.add-effect-updates-existing",
      "domain": "effects",
      "subject": "Entity.addEffect",
      "statement": "Entity.addEffect adds or updates an effect for a duration in ticks and can throw on invalid effect, duration, amplifier, or entity state; applying an effect is therefore a mutable runtime operation with explicit failure modes.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-effects-entity"
      ],
      "capabilityTags": [
        "status-effect",
        "duration"
      ],
      "riskSurfaces": [
        "effect-leak",
        "invalid-effect",
        "partial-transition"
      ]
    },
    {
      "id": "effects.health-is-attribute-component",
      "domain": "effects",
      "subject": "EntityHealthComponent",
      "statement": "EntityHealthComponent extends the entity attribute component and exposes current/max health semantics, so maximum-health changes and current-health state are related but distinct values that require reconciliation.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-effects-health"
      ],
      "capabilityTags": [
        "health",
        "attribute"
      ],
      "riskSurfaces": [
        "max-health-desync",
        "revive-health"
      ]
    },
    {
      "id": "effects.component-group-replaces-same-type",
      "domain": "effects",
      "subject": "component group activation",
      "statement": "Adding a component group can replace an already-active component of the same type, meaning component-group changes can alter health, timers, movement, AI, or other behavior surfaces rather than simply append new behavior.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-effects-component-groups",
        "ms-effects-add-component-group"
      ],
      "capabilityTags": [
        "component-group",
        "replacement"
      ],
      "riskSurfaces": [
        "attribute-overwrite",
        "behavior-overwrite"
      ]
    },
    {
      "id": "effects.readding-group-reinitializes",
      "domain": "effects",
      "subject": "re-adding active component group",
      "statement": "Adding a component group that is already active can re-initialize its components; for stateful components such as timers, associated logic can restart.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-effects-component-groups",
