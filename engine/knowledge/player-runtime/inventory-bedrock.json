        "invalid-handle"
      ]
    },
    {
      "id": "inventory.getitem-returns-copy",
      "domain": "inventory",
      "subject": "ContainerSlot.getItem",
      "statement": "ContainerSlot.getItem returns an exact copy of the item stack. Mutating that returned ItemStack does not by itself prove the original slot was updated; an explicit write-back path is required.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-inv-slot",
        "ms-inv-itemstack"
      ],
      "capabilityTags": [
        "ItemStack",
        "copy-semantics"
      ],
      "riskSurfaces": [
        "lost-update",
        "equipment-desync"
      ]
    },
    {
      "id": "inventory.setitem-replaces-slot",
      "domain": "inventory",
      "subject": "ContainerSlot.setItem",
      "statement": "ContainerSlot.setItem replaces the item in that slot and cannot be called in restricted-execution mode; slot writes may throw container-rule or validity errors.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-inv-slot"
      ],
      "capabilityTags": [
        "inventory-write",
        "restricted-execution"
      ],
      "riskSurfaces": [
        "partial-reset",
        "write-failure"
      ]
    },
    {
      "id": "inventory.equipment-separate-surface",
      "domain": "inventory",
      "subject": "EntityEquippableComponent",
      "statement": "Equipment slots are exposed through an equippable component with separate get/set operations, so clearing inventory storage alone does not prove equipped items were reset.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
