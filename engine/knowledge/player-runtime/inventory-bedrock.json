        "loadout-reset"
      ]
    },
    {
      "id": "inventory.container-additem-can-leave-remainder",
      "domain": "inventory",
      "subject": "Container.addItem",
      "statement": "Container add operations can fail due to invalid container state and may be constrained by available slots/stack rules, so a grant path must verify the intended item quantity actually entered the inventory rather than treating the call as an unconditional commit.",
      "classification": "derived-rule",
      "applicability": {
