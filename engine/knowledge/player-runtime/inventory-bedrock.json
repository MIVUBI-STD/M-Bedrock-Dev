    {
      "id": "inventory.entity-component-container-invalid-on-removed",
      "domain": "inventory",
      "subject": "EntityInventoryComponent.container",
      "statement": "An entity inventory container becomes unavailable/invalid when the owning entity is removed, so cached inventory handles must not be treated as durable across entity/session lifecycle changes.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-inv-entity-inventory"
      ],
      "capabilityTags": [
        "inventory",
        "container-validity"
      ],
      "riskSurfaces": [
        "stale-reference",
        "respawn",
        "disconnect"
      ]
    },
    {
      "id": "inventory.slot-validity-runtime",
      "domain": "inventory",
      "subject": "ContainerSlot.isValid",
      "statement": "ContainerSlot exposes runtime validity and slot operations can throw InvalidContainerSlotError, so cached slot handles require validation before use.",
      "classification": "engine-fact",
      "applicability": {
