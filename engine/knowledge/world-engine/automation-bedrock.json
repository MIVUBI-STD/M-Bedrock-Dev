        "hybrid-authority"
      ]
    },
    {
      "id": "automation.redstone-update-needs-consumer",
      "domain": "automation",
      "subject": "onRedstoneUpdate",
      "statement": "onRedstoneUpdate is tied to the block redstone-consumer component and qualifying signal strength, so redstone signal configuration is part of the effective trigger contract.",
