    {
      "id": "automation.command-block-mode-semantics",
      "domain": "automation",
      "subject": "command block execution mode",
      "statement": "Command blocks can operate as impulse, chain, or repeating blocks, with redstone requirement and always-active settings that materially change when and how often commands execute.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-automation-command-blocks"
      ],
      "capabilityTags": [
        "command-block",
        "execution-mode"
      ],
      "riskSurfaces": [
        "repeat-trigger",
        "chain-break",
        "unexpected-always-active"
      ]
    },
    {
      "id": "automation.chain-conditional-depends-previous",
      "domain": "automation",
      "subject": "conditional chain command",
      "statement": "Conditional chain command blocks depend on success of the preceding command block in the chain, so command success/failure becomes control-flow state for downstream automation.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-automation-inworld-game",
        "ms-automation-command-blocks"
      ],
      "capabilityTags": [
        "command-chain",
        "conditional"
      ],
      "riskSurfaces": [
        "chain-short-circuit",
        "hidden-dependency"
      ]
    },
    {
      "id": "automation.repeat-delay-firsttick",
      "domain": "automation",
      "subject": "repeating command block delay",
      "statement": "Repeating command blocks can have Delay in Ticks and Execute on First Tick behavior, so activation timing is not equivalent to immediate execution and can differ on the first cycle versus later cycles.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-automation-command-blocks"
      ],
      "capabilityTags": [
        "command-block",
        "delay"
      ],
      "riskSurfaces": [
        "timing-race",
        "duplicate-trigger",
        "missed-first-run"
      ]
    },
    {
      "id": "automation.block-tick-random-interval",
      "domain": "automation",
      "subject": "minecraft:tick",
      "statement": "The minecraft:tick block component schedules block ticks using an interval_range and can loop or run once; each subsequent interval may be chosen again from the configured range.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-automation-block-tick"
      ],
      "capabilityTags": [
        "block-tick",
        "scheduler"
      ],
      "riskSurfaces": [
        "nondeterministic-timing",
        "residual-automation"
      ]
    },
    {
      "id": "automation.block-custom-events",
      "domain": "automation",
      "subject": "BlockCustomComponent events",
      "statement": "Block custom components can receive targeted events including onTick, onRandomTick, onRedstoneUpdate, onStepOn, and onStepOff, creating block-driven script entrypoints separate from general world events.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
