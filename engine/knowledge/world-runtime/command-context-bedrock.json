  "facts": [
    {
      "id": "command-context.execute-as-changes-executor",
      "domain": "command-context",
      "subject": "/execute as",
      "statement": "/execute as changes the executing entity context for the nested command; selector @s therefore follows the current executor rather than a globally fixed player.",
      "classification": "engine-fact",
      "applicability": { "editions": ["bedrock", "education"] },
      "sourceIds": ["ms-command-execute", "ms-command-selectors"],
      "capabilityTags": ["command:execute", "selector:@s"],
      "riskSurfaces": ["executor-context", "selector-scope"]
    },
    {
      "id": "command-context.execute-at-changes-position",
      "domain": "command-context",
      "subject": "/execute at",
      "statement": "/execute at changes the positional execution origin to the selected entity without being equivalent to changing every other execution-context field.",
      "classification": "engine-fact",
      "applicability": { "editions": ["bedrock", "education"] },
      "sourceIds": ["ms-command-execute"],
      "capabilityTags": ["command:execute", "position-context"],
      "riskSurfaces": ["coordinate-origin", "selector-radius", "relative-coordinate"]
    },
    {
      "id": "command-context.execute-in-changes-dimension",
      "domain": "command-context",
      "subject": "/execute in",
      "statement": "/execute in changes the dimension in which the nested command executes, so otherwise identical relative coordinates or selectors may resolve against a different dimension context.",
      "classification": "engine-fact",
      "applicability": { "editions": ["bedrock", "education"] },
      "sourceIds": ["ms-command-execute"],
      "capabilityTags": ["command:execute", "dimension-context"],
      "riskSurfaces": ["wrong-dimension", "cross-dimension-state"]
    },
    {
      "id": "command-context.positioned-and-rotated-independent",
      "domain": "command-context",
      "subject": "/execute positioned and rotated",
      "statement": "/execute positioned and rotated alter position and rotation context independently, so nested commands using relative/local coordinates can change meaning without changing the selected target.",
      "classification": "engine-fact",
      "applicability": { "editions": ["bedrock", "education"] },
      "sourceIds": ["ms-command-execute"],
      "capabilityTags": ["position-context", "rotation-context"],
      "riskSurfaces": ["coordinate-transform", "wrong-origin"]
    },
    {
      "id": "command-context.selector-p-origin-sensitive",
      "domain": "command-context",
      "subject": "@p",
      "statement": "@p selects the closest living player relative to the current execution origin unless selector x/y/z override that origin; in a command block, the command block location is the default origin.",
      "classification": "engine-fact",
      "applicability": { "editions": ["bedrock", "education"] },
      "sourceIds": ["ms-command-selectors"],
      "capabilityTags": ["selector:@p", "execution-origin"],
      "riskSurfaces": ["wrong-player", "multi-arena-leak"]
    },
    {
      "id": "command-context.selector-radius-origin-sensitive",
      "domain": "command-context",
      "subject": "selector radius",
      "statement": "Selector r/rm and dx/dy/dz are evaluated from the current execution origin unless explicit x/y/z parameters redefine the origin.",
      "classification": "engine-fact",
      "applicability": { "editions": ["bedrock", "education"] },
      "sourceIds": ["ms-command-selectors"],
      "capabilityTags": ["selector:radius", "selector:volume"],
      "riskSurfaces": ["wrong-area", "multi-arena-leak", "coordinate-origin"]
    },
    {
      "id": "command-context.selector-a-all-online",
      "domain": "command-context",
      "subject": "@a",
      "statement": "@a selects all online players, including players regardless of alive state, unless filters narrow the set.",
      "classification": "engine-fact",
      "applicability": { "editions": ["bedrock", "education"] },
      "sourceIds": ["ms-command-selectors"],
      "capabilityTags": ["selector:@a"],
      "riskSurfaces": ["global-player-scope", "dead-player-targeting", "arena-isolation"]
    },
    {
      "id": "command-context.selector-no-match-fails",
      "domain": "command-context",
      "subject": "selector no-match",
      "statement": "If a target selector resolves no targets, the command fails to run; no-match is therefore a control-flow outcome, not equivalent to a successful no-op.",
      "classification": "engine-fact",
      "applicability": { "editions": ["bedrock", "education"] },
      "sourceIds": ["ms-command-selectors"],
      "capabilityTags": ["selector", "command-result"],
      "riskSurfaces": ["control-flow", "silent-failure"]
    },
    {
      "id": "command-context.command-block-s-has-no-entity",
      "domain": "command-context",
      "subject": "@s from command block",
      "statement": "A command block does not provide an executing entity for @s in the same way an entity executor does; commands such as tp @s from a command block therefore do not behave like entity-run commands.",
      "classification": "engine-fact",
      "applicability": { "editions": ["bedrock", "education"] },
      "sourceIds": ["ms-command-popular", "ms-command-selectors"],
      "capabilityTags": ["command-block", "selector:@s"],
      "riskSurfaces": ["executor-context", "command-block-runtime"]
    },
    {
      "id": "command-context.dimension-runcommand-dimension-context",
      "domain": "command-context",
      "subject": "Dimension.runCommand",
      "statement": "Dimension.runCommand executes synchronously in the context of that Dimension and returns a CommandResult with success count; it cannot be called in restricted execution and may throw CommandError.",
      "classification": "engine-fact",
      "applicability": { "editions": ["bedrock", "education"] },
      "sourceIds": ["ms-command-dimension"],
      "capabilityTags": ["script-command", "Dimension.runCommand"],
      "riskSurfaces": ["wrong-dimension", "restricted-execution", "command-failure"]
    },
    {
      "id": "command-context.entity-runcommand-entity-context",
      "domain": "command-context",
      "subject": "Entity.runCommand",
      "statement": "Entity command execution uses an entity execution context and can fail if the entity is invalid, so entity-bound command behavior must not be conflated with dimension-bound or command-block execution.",
      "classification": "derived-rule",
      "applicability": { "editions": ["bedrock", "education"] },
      "sourceIds": ["ms-command-entity-1xx"],
      "capabilityTags": ["script-command", "entity-context"],
      "riskSurfaces": ["stale-entity", "executor-context"]
    }
