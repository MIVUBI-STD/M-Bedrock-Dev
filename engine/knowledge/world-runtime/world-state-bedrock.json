      "domain": "world-state",
      "subject": "gamerules",
      "statement": "Game rules are world-level settings that change gameplay behavior for the world, including PvP, keepInventory, mob spawning, fire tick, damage rules, command blocks, daylight/weather cycles, immediate respawn, and related behavior.",
      "classification": "engine-fact",
