    {
      "id": "compat.experiments-change-over-time",
      "domain": "compatibility",
      "subject": "world experiments",
      "statement": "Available experimental feature toggles change over time and differ between retail and Preview builds, so experiment names/presence cannot be assumed stable across versions.",
