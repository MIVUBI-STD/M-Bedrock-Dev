      ],
      "capabilityTags": [
        "script-api",
        "semver"
      ],
      "riskSurfaces": [
        "api-breakage",
        "compile-runtime-mismatch"
      ]
    },
    {
      "id": "compat.beta-requires-experiment",
      "domain": "compatibility",
      "subject": "Beta APIs",
      "statement": "Beta Script API usage depends on beta module versions and the Beta APIs experiment; beta APIs may change across builds without advance notice.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
