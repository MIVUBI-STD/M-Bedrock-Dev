      "id": "compat.latest-platform-needs-revalidation",
      "domain": "compatibility",
      "subject": "game update",
      "statement": "Microsoft guidance recommends validating worlds when upgrading platform/base-game versions because new engine/content behavior can introduce gameplay regressions even without project code changes.",
