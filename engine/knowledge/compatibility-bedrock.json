    {
      "id": "compat.manifest-defines-load-contract",
      "domain": "compatibility",
      "subject": "manifest.json",
      "statement": "Behavior/resource packs declare identity, modules, dependencies, minimum engine version, capabilities, and script entrypoints through manifest.json; these fields are part of the pack load/runtime contract.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-compat-manifest"
      ],
      "capabilityTags": [
        "manifest",
        "pack-load"
      ],
      "riskSurfaces": [
        "pack-not-loaded",
        "wrong-module",
        "dependency-mismatch"
      ]
    },
    {
      "id": "compat.dependencies-require-version-match",
      "domain": "compatibility",
      "subject": "manifest dependencies",
      "statement": "Pack dependencies reference exact UUID/version pairs for other packs or module_name/version pairs for built-in Script API modules, so dependency drift can change availability or prevent expected content from loading.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-compat-manifest"
      ],
      "capabilityTags": [
        "dependencies",
        "script-module"
      ],
      "riskSurfaces": [
        "version-drift",
        "missing-module"
      ]
    },
    {
      "id": "compat.min-engine-affects-semantics",
      "domain": "compatibility",
      "subject": "min_engine_version",
      "statement": "min_engine_version influences compatibility behavior including command/function and behavior interpretation, so two packs with identical logic but different engine-version declarations can execute under different compatibility semantics.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-compat-platform-guidance",
        "ms-compat-manifest"
      ],
      "capabilityTags": [
        "min-engine-version",
        "compatibility"
      ],
      "riskSurfaces": [
        "command-regression",
        "behavior-regression"
      ]
    },
    {
      "id": "compat.script-major-can-break",
      "domain": "compatibility",
      "subject": "Script API major version",
      "statement": "Minecraft Script API major versions may change for backwards-compatibility-impacting changes, while minor versions are generally additive, so major-version drift must be treated as a compatibility boundary.",
      "classification": "engine-fact",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "ms-compat-platform-guidance",
