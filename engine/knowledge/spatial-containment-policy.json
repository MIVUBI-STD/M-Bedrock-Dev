        "missing-floor"
      ]
    },
    {
      "id": "spatial-policy.safe-return-chain",
      "domain": "spatial-containment",
      "subject": "out-of-bounds recovery",
      "statement": "Out-of-bounds recovery should use an ordered safe-return chain tied to current authority: local safe anchor, arena recovery anchor, lobby/safe-world fallback. Failed or invalid primary recovery must not commit stale arena membership.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
