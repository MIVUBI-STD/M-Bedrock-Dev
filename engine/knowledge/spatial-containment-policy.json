      ],
      "riskSurfaces": [
        "proximity-leak",
        "neighbor-capture"
      ]
    },
    {
      "id": "spatial-policy.boundary-world-mutation-reverify",
      "domain": "spatial-containment",
      "subject": "boundary geometry",
      "statement": "World mutation that changes walls, gates, floors, void barriers, bridges, or containment blocks invalidates spatial-containment assumptions and requires boundary re-verification before arena start or reuse.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
