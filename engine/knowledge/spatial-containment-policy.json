  "facts": [
    {
      "id": "spatial-policy.arena-volume-contract",
      "domain": "spatial-containment",
      "subject": "arena spatial authority",
      "statement": "Every arena must declare a spatial contract containing dimension id, playable bounds, setup/loader bounds, projectile/entity containment bounds, entry/exit anchors, void/fall thresholds, and neighboring-arena separation rules.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-spatial-containment-policy-v1"
      ],
      "capabilityTags": [
        "arena-bounds",
        "spatial-authority"
      ],
      "riskSurfaces": [
        "cross-arena-leak",
        "escape"
      ]
    },
    {
      "id": "spatial-policy.dimension-first-membership",
      "domain": "spatial-containment",
      "subject": "spatial membership",
      "statement": "Arena membership checks compare dimension before coordinates. Matching x/z/y ranges in a different dimension must never satisfy arena spatial membership.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-spatial-containment-policy-v1"
      ],
      "capabilityTags": [
        "dimension",
        "membership"
      ],
      "riskSurfaces": [
        "cross-dimension-selector-leak"
      ]
    },
    {
      "id": "spatial-policy.bounds-not-authority-alone",
      "domain": "spatial-containment",
      "subject": "arena membership authority",
      "statement": "Physical containment is evidence and safety policy, not sole gameplay authority. Being inside an arena volume does not automatically enroll an entity/player without current arena-generation ownership.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-spatial-containment-policy-v1"
      ],
      "capabilityTags": [
        "state-authority",
        "spatial"
      ],
      "riskSurfaces": [
        "proximity-enrollment",
        "wrong-arena"
      ]
    },
    {
      "id": "spatial-policy.escaped-entity-classification",
      "domain": "spatial-containment",
      "subject": "entity outside arena",
      "statement": "When an arena-owned entity exits its permitted volume, classify the cause before recovery: valid route extension, knockback, AI path failure, teleport error, world mutation opening, crowd displacement, or stale generation. Do not immediately teleport without diagnosis.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-spatial-containment-policy-v1"
      ],
      "capabilityTags": [
        "escape",
        "diagnosis"
      ],
      "riskSurfaces": [
        "false-recovery",
        "entity-tug"
      ]
    },
    {
      "id": "spatial-policy.void-recovery-generation-bound",
      "domain": "spatial-containment",
      "subject": "void/fall recovery",
      "statement": "Anti-void/fall recovery must capture player/entity identity, arenaGeneration, life/entity generation, recoveryGeneration, intended safe destination, and current dimension; stale recovery cannot pull a player/entity back into an old arena.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-spatial-containment-policy-v1"
      ],
      "capabilityTags": [
        "void-recovery",
        "generation-token"
      ],
      "riskSurfaces": [
        "old-arena-teleport",
        "stale-recovery"
      ]
    },
    {
      "id": "spatial-policy.dimension-height-dynamic",
      "domain": "spatial-containment",
      "subject": "vertical bounds",
      "statement": "Use the current dimension heightRange or declared custom-dimension bounds for Y validation. Hard-coded global Y assumptions are prohibited in reusable analyzers.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-spatial-containment-policy-v1"
      ],
      "capabilityTags": [
        "height-range",
        "compatibility"
      ],
      "riskSurfaces": [
        "hardcoded-y",
        "custom-dimension-bug"
      ]
    },
    {
      "id": "spatial-policy.projectile-containment",
      "domain": "spatial-containment",
      "subject": "projectile boundary",
      "statement": "Projectiles and combat effects must be checked against arena spatial and generation ownership when they cross arena boundaries; leaving the combat volume should invalidate or constrain gameplay attribution according to mode policy.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-spatial-containment-policy-v1"
      ],
      "capabilityTags": [
        "projectile",
        "arena-boundary"
      ],
      "riskSurfaces": [
        "cross-arena-hit",
        "stale-projectile"
      ]
    },
    {
      "id": "spatial-policy.neighbor-separation",
      "domain": "spatial-containment",
      "subject": "multi-arena layout",
      "statement": "Multi-arena layouts must define minimum separation or explicit isolation sufficient for selectors, projectiles, sounds/particles where relevant, mob navigation, and recovery teleports so one arena's physical activity cannot accidentally enter another's scope.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
        "mivubi-spatial-containment-policy-v1"
      ],
      "capabilityTags": [
        "multi-arena",
        "layout"
      ],
      "riskSurfaces": [
        "cross-arena-proximity",
        "projectile-leak",
        "ai-leak"
      ]
    },
    {
      "id": "spatial-policy.selector-spatial-filter-not-enough",
      "domain": "spatial-containment",
      "subject": "spatial selector",
      "statement": "Selectors using radius/volume filters must combine spatial filters with project-owned arena/generation identity for critical logic. Proximity alone is insufficient in adjacent or overlapping operational regions.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
      },
      "sourceIds": [
