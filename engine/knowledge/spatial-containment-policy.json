        "state-location-divergence"
      ]
    },
    {
      "id": "spatial-policy.containment-monitor-budget",
      "domain": "spatial-containment",
      "subject": "boundary monitoring",
      "statement": "Continuous containment checks must use targeted registries and bounded cadence rather than broad all-entity scans every tick; spatial safety remains subject to per-arena/global performance budgets.",
      "classification": "project-policy",
      "applicability": {
        "editions": [
          "bedrock",
          "education"
        ]
