{
  "schemaVersion": 1,
  "title": "Multi-Scenario Check Ledger",
  "purpose": "Machine-readable bounded scenario coverage for deterministic virtual testing. Maximize relevant scenario coverage while keeping publication proof-gated.",
  "required": [
    "scenarioId",
    "projectId",
    "family",
    "initialState",
    "events",
    "sharedMaterialDependency",
    "expectedInvariant",
    "result"
  ],
  "properties": {
    "scenarioId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "family": {
      "enum": [
        "TRANSITION_RESIDUE",
        "OBJECTIVE_CUSTODY",
        "WORLD_MUTATION_COMPATIBILITY",
        "OFFLINE_PROGRESSION",
        "CONTAINER_ECONOMY_CARRYOVER",
        "DISCONNECT_RECONNECT",
        "RELOAD_RECOVERY",
        "MULTIPLAYER_INTERLEAVING",
        "MULTIARENA_INTERLEAVING",
        "CAPABILITY_ABUSE"
      ],
      "description": "Stable internal family ID. Use canonical display names from familyDisplayNames; do not create ad-hoc family names from tester wording."
    },
    "pressureScore": {
      "type": "integer",
      "minimum": 0
    },
    "pressureReasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "initialState": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sharedMaterialDependency": {
      "type": "string"
    },
    "expectedInvariant": {
      "type": "string"
    },
    "mutableResources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "writers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clearers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deferredWriters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockingProof": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proofMethods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "enum": [
        "SAFE",
        "CONTRADICTION",
        "IRREDUCIBLE_RUNTIME_QUESTION"
      ]
    },
    "findingId": {
      "type": [
        "string",
        "null"
      ]
    },
    "exactRuntimeQuestion": {
      "type": [
        "string",
        "null"
      ]
    },
    "observableA": {
      "type": [
        "string",
        "null"
      ]
    },
    "observableB": {
      "type": [
        "string",
        "null"
      ]
    },
    "coveredByScenarioId": {
      "type": [
        "string",
        "null"
      ]
    },
    "appliedChecks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "Stage Transition State Check",
          "Carried Objective Ownership Check",
          "Shared World State Check",
          "Offline Progression Check",
          "Container & Economy Reset Check",
          "Disconnect / Reconnect Check",
          "Reload Recovery Check",
          "Multiplayer Shared-State Check",
          "Multi-Arena Isolation Check",
          "Player Capability Check",
          "State Snapshot Differential",
          "Cross-Representation Consistency Check",
          "Event Ordering & Duplicate Commit Check",
          "Orphan State & Entity Check",
          "Path & Geometry Dependency Check",
          "Metamorphic Comparison Check"
        ]
      }
    },
    "stateSnapshot": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "boundary": {
          "type": "string"
        },
        "before": {
          "type": "object"
        },
        "expectedAfter": {
          "type": "object"
        },
        "reachableAfter": {
          "type": "object"
        },
        "deltas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "representations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept": {
            "type": "string"
          },
          "representation": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "consistent": {
            "type": "boolean"
          }
        }
      }
    },
    "eventOrdering": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventOrCommitTarget": {
            "type": "string"
          },
          "producers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subscribers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "guard": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        }
      }
    },
    "lifetimeObjects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "releasePath": {
            "type": "string"
          },
          "ownerInvalidationBehavior": {
            "type": "string"
          },
          "closed": {
            "type": "boolean"
          }
        }
      }
    },
    "geometryDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor": {
            "type": "string"
          },
          "routeOrVolume": {
            "type": "string"
          },
          "obstructionOrMutation": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        }
      }
    },
    "metamorphicComparison": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "baseline": {
          "type": "string"
        },
        "comparison": {
          "type": "string"
        },
        "sharedContract": {
          "type": "string"
        },
        "allowedDifferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "materialDifferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "result": {
          "type": "string"
        }
      }
    }
  },
  "rules": [
    "Do not generate Cartesian products. A scenario requires a shared state/resource/owner/geometry/transition.",
    "Pairwise coverage is default; use 3-way only when all dimensions converge on the same material contract.",
    "Pressure score orders work only; it never changes proof state or severity.",
    "IRREDUCIBLE_RUNTIME_QUESTION requires one exact unresolved deciding fact and is routed to the Runtime Test Queue.",
    "A scenario may be dominance-pruned only when the covering scenario preserves every material condition and expected contract.",
    "Use appliedChecks to record canonical check names; do not mint map-specific permanent check names.",
    "State snapshots, representation inventories, lifetime objects, and metamorphic comparisons are evidence structures, not new report issue types."
  ],
  "familyDisplayNames": {
    "TRANSITION_RESIDUE": "Stage Transition State Check",
    "OBJECTIVE_CUSTODY": "Carried Objective Ownership Check",
    "WORLD_MUTATION_COMPATIBILITY": "Shared World State Check",
    "OFFLINE_PROGRESSION": "Offline Progression Check",
    "CONTAINER_ECONOMY_CARRYOVER": "Container & Economy Reset Check",
    "DISCONNECT_RECONNECT": "Disconnect / Reconnect Check",
    "RELOAD_RECOVERY": "Reload Recovery Check",
    "MULTIPLAYER_INTERLEAVING": "Multiplayer Shared-State Check",
    "MULTIARENA_INTERLEAVING": "Multi-Arena Isolation Check",
    "CAPABILITY_ABUSE": "Player Capability Check"
  },
  "namingRules": [
    "Tester and user wording is evidence input, not permanent taxonomy.",
    "Map-specific nouns such as station number, spruce, flag, chest, or cinematic belong in scenario evidence, not family names.",
    "Use one canonical display name per family.",
    "Do not create a new family when an existing family already represents the same state, ownership, transition, or capability contract."
  ]
}
