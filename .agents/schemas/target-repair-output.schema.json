{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M-Bedrock Target Repair Output",
  "type": "object",
  "required": [
    "schemaVersion",
    "repairAuthority",
    "mustChange",
    "mustPreserve",
    "targetOwner",
    "changedSemanticSurface",
    "verification"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "targetOwner": {
      "type": "string",
      "minLength": 1
    },
    "changedSemanticSurface": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object"
    },
    "runtimeResidue": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repairAuthority": {
      "enum": [
        "approved-bug",
        "intentional-modification"
      ]
    },
    "approvedBugSemanticKey": {
      "type": "string",
      "minLength": 1
    },
    "mustChange": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "mustPreserve": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "repairAuthority": {
            "const": "approved-bug"
          }
        },
        "required": [
          "repairAuthority"
        ]
      },
      "then": {
        "required": [
          "approvedBugSemanticKey"
        ]
      }
    }
  ]
}
