          },
          "gameplayFlow": {
            "enum": [
              "ENTRY_JOIN",
              "READY_START",
              "SETUP",
              "ACTIVE_GAMEPLAY",
              "PROGRESSION",
              "TERMINAL",
              "CLEANUP_REPLAY",
              "RECOVERY"
            ]
          },
          "severity": {
            "enum": [
              "Blocker",
              "Major",
              "Minor"
            ]
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "playerImpact": {
            "type": "string"
          },
          "reproduceSteps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "proofCeiling": {
            "enum": [
              "PROVEN",
              "NEEDS_DECIDING_PROOF"
            ]
          },
          "counterEvidence": {
            "enum": [
              "cleared",
              "unresolved"
            ]
          },
          "mismatchKind": {
            "enum": [
              "capacity",
              "capability",
              "design-implementation",
              "player-expectation"
            ]
          },
          "technicalConstraint": {
            "type": "string",
            "minLength": 1
          },
          "failureDomain": {
            "enum": [
              "arena-multi-arena",
              "inventory-economy",
              "progression-wave-objective",
              "chunk-simulation",
              "player-lifecycle",
              "entity-ai-combat",
              "world-structure-mutation",
              "ui-feedback-information",
              "state-ownership",
              "temporal-async",
              "boundary-capacity",
              "persistence-recovery",
              "platform-performance"
            ]
          },
          "issueType": {
            "const": "DESIGN_MISMATCH"
          },
          "informationMismatch": {
            "type": "boolean"
          },
          "playerFacingEvidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "contributingDomains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "arena-multi-arena",
                "inventory-economy",
                "progression-wave-objective",
                "chunk-simulation",
                "player-lifecycle",
                "entity-ai-combat",
                "world-structure-mutation",
                "ui-feedback-information",
                "state-ownership",
                "temporal-async",
                "boundary-capacity",
                "persistence-recovery",
                "platform-performance"
              ]
            }
          },
          "validationReason": {
            "type": "string",
            "minLength": 1
          },
          "missingProof": {
            "type": "string",
            "minLength": 1
          },
          "validationTest": {
            "type": "string",
            "minLength": 1
          },
          "validationGroupKey": {
            "type": "string",
            "minLength": 1
          },
          "proofNavigation": {
            "type": "object",
            "required": [
              "recipeId",
              "proofGoal",
              "provenClaims",
              "missingClaims",
              "route",
              "evidenceSubstitutions",
              "historicalSearchHints",
              "historyPressure",
              "familyProofCriteria",
              "proofStopRule",
              "runtimeLastResort"
            ],
            "properties": {
              "recipeId": {
                "type": "string",
                "minLength": 1
              },
              "proofGoal": {
                "type": "string",
                "minLength": 1
              },
              "provenClaims": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "missingClaims": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "route": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "order",
                    "knowledgeDomain",
                    "question",
                    "purpose",
                    "evidencePreference"
                  ],
                  "properties": {
                    "order": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "knowledgeDomain": {
                      "type": "string",
                      "minLength": 1
                    },
                    "question": {
                      "type": "string",
                      "minLength": 1
                    },
                    "purpose": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidencePreference": {
                      "enum": [
                        "selected-artifact",
                        "cross-domain",
                        "formal",
                        "runtime"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "evidenceSubstitutions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
