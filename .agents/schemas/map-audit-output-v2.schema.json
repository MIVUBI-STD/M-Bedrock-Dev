{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M-Bedrock Map Audit Output V2",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactId",
    "mapVersion",
    "evidenceScope",
    "gameDesign",
    "gameplayClosure",
    "gameplayFlow",
    "stateTransitions",
    "multiArena",
    "coverage",
    "bugs",
    "designMismatches"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "artifactId": {
      "type": "string",
      "minLength": 1
    },
    "mapVersion": {
      "type": "string",
      "minLength": 1
    },
    "evidenceScope": {
      "type": "object",
      "required": [
        "mode",
        "selectedArtifact",
        "archiveSourcesUsed"
      ],
      "properties": {
        "mode": {
          "const": "selected-map-version-only"
        },
        "selectedArtifact": {
          "type": "string",
          "minLength": 1
        },
        "archiveSourcesUsed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "gameDesign": {
      "type": "object",
      "required": [
        "objective",
        "winCondition",
        "loseCondition",
        "resetRules",
        "preserveRules",
        "progressionRules"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "winCondition": {
          "type": "string",
          "minLength": 1
        },
        "loseCondition": {
          "type": "string",
          "minLength": 1
        },
        "resetRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserveRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "progressionRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "gameplayFlow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stateTransitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "event",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "multiArena": {
      "type": "object",
      "required": [
        "supported",
        "visibleArenaCount",
        "concurrentArenaLimit",
        "queueBehavior",
        "isolationRules"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "visibleArenaCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "concurrentArenaLimit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "queueBehavior": {
          "type": "string"
        },
        "playerFeedback": {
          "type": "string"
        },
        "isolationRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "required": [
        "disposition",
        "records"
      ],
      "properties": {
        "disposition": {
          "const": "accounted"
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "surface",
              "status"
            ],
            "properties": {
              "surface": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "checked",
                  "blocked",
                  "not-applicable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "blocked"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "reason"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "not-applicable"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "reason"
                  ]
                }
              }
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "bugs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "gameplayFlow",
          "failureDomain",
          "informationMismatch",
          "issue",
          "reproduceSteps",
          "expected",
          "actual",
          "proofCeiling",
          "issueType",
          "contributingDomains"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PROVEN",
              "NEED_VALIDATION"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "deprecated": true,
            "description": "Legacy compatibility metadata. failureDomain is the canonical audit taxonomy."
          },
          "gameplayFlow": {
            "enum": [
              "ENTRY_JOIN",
              "READY_START",
              "SETUP",
              "ACTIVE_GAMEPLAY",
              "PROGRESSION",
              "TERMINAL",
              "CLEANUP_REPLAY",
              "RECOVERY"
            ]
          },
          "severity": {
            "enum": [
              "Blocker",
              "Major",
              "Minor"
            ]
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "playerImpact": {
            "type": "string"
          },
          "reproduceSteps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "proofCeiling": {
            "enum": [
              "STATIC VERIFIED",
              "PACKAGE VERIFIED",
              "LOCAL GAME VERIFIED",
              "LIVE GAME VERIFIED",
              "UNKNOWN"
            ]
          },
          "counterEvidence": {
            "enum": [
              "cleared",
              "present",
              "unresolved"
            ]
          },
          "testerTriggerReady": {
            "type": "boolean"
          },
          "failureDomain": {
            "enum": [
              "arena-multi-arena",
              "inventory-economy",
              "progression-wave-objective",
              "chunk-simulation",
              "player-lifecycle",
              "entity-ai-combat",
              "world-structure-mutation",
              "ui-feedback-information",
              "state-ownership",
              "temporal-async",
              "boundary-capacity",
              "persistence-recovery",
              "platform-performance"
            ]
          },
          "issueType": {
            "const": "BUG"
          },
          "informationMismatch": {
            "type": "boolean"
          },
          "playerFacingEvidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "contributingDomains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "arena-multi-arena",
                "inventory-economy",
                "progression-wave-objective",
                "chunk-simulation",
                "player-lifecycle",
                "entity-ai-combat",
                "world-structure-mutation",
                "ui-feedback-information",
                "state-ownership",
                "temporal-async",
                "boundary-capacity",
                "persistence-recovery",
                "platform-performance"
              ]
            }
          },
          "validationReason": {
            "type": "string",
            "minLength": 1
          },
          "missingProof": {
            "type": "string",
            "minLength": 1
          },
          "validationTest": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PROVEN"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "severity",
                "playerImpact",
                "counterEvidence",
                "testerTriggerReady"
              ],
              "properties": {
                "counterEvidence": {
                  "const": "cleared"
                },
                "testerTriggerReady": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "NEED_VALIDATION"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "validationReason",
                "missingProof",
                "validationTest"
              ],
              "not": {
                "required": [
                  "severity"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "informationMismatch": {
                  "const": true
                }
              },
              "required": [
                "informationMismatch"
              ]
            },
            "then": {
              "required": [
                "playerFacingEvidenceIds"
              ]
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "gameplayClosure": {
      "type": "object",
      "required": [
        "status",
        "surfaceInventory",
        "stateModelComplete",
        "boundariesExtracted",
        "unaccountedSurfaceIds"
      ],
      "properties": {
        "status": {
          "enum": [
            "CLOSED",
            "PARTIAL",
            "OPEN"
          ]
        },
        "surfaceInventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "understood",
                  "blocked",
                  "unknown",
                  "not-applicable"
                ]
              },
              "reason": {
                "type": "string"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "boundaries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "blocked",
                        "unknown",
                        "not-applicable"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "reason"
                  ]
                }
              }
            ],
            "additionalProperties": true
          }
        },
        "stateModelComplete": {
          "type": "boolean"
        },
        "boundariesExtracted": {
          "type": "boolean"
        },
        "unaccountedSurfaceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "CLOSED",
                  "PARTIAL"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "unaccountedSurfaceIds": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "OPEN"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "unaccountedSurfaceIds": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "stateModelComplete": {
                    "const": false
                  }
                },
                "required": [
                  "stateModelComplete"
                ]
              },
              {
                "properties": {
                  "boundariesExtracted": {
                    "const": false
                  }
                },
                "required": [
                  "boundariesExtracted"
                ]
              }
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "designMismatches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "gameplayFlow",
          "failureDomain",
          "informationMismatch",
          "issue",
          "reproduceSteps",
          "expected",
          "actual",
          "proofCeiling",
          "issueType",
          "contributingDomains"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PROVEN",
              "NEED_VALIDATION"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "deprecated": true,
            "description": "Legacy compatibility metadata. failureDomain is the canonical audit taxonomy."
          },
          "gameplayFlow": {
            "enum": [
              "ENTRY_JOIN",
              "READY_START",
              "SETUP",
              "ACTIVE_GAMEPLAY",
              "PROGRESSION",
              "TERMINAL",
              "CLEANUP_REPLAY",
              "RECOVERY"
            ]
          },
          "severity": {
            "enum": [
              "Blocker",
              "Major",
              "Minor"
            ]
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "playerImpact": {
            "type": "string"
          },
          "reproduceSteps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "proofCeiling": {
            "enum": [
              "STATIC VERIFIED",
              "PACKAGE VERIFIED",
              "LOCAL GAME VERIFIED",
              "LIVE GAME VERIFIED",
              "UNKNOWN"
            ]
          },
          "counterEvidence": {
            "enum": [
              "cleared",
              "present",
              "unresolved"
            ]
          },
          "testerTriggerReady": {
            "type": "boolean"
          },
          "mismatchKind": {
            "enum": [
              "capacity",
              "capability",
              "design-implementation",
              "player-expectation"
            ]
          },
          "technicalConstraint": {
            "type": "string",
            "minLength": 1
          },
          "failureDomain": {
            "enum": [
              "arena-multi-arena",
              "inventory-economy",
              "progression-wave-objective",
              "chunk-simulation",
              "player-lifecycle",
              "entity-ai-combat",
              "world-structure-mutation",
              "ui-feedback-information",
              "state-ownership",
              "temporal-async",
              "boundary-capacity",
              "persistence-recovery",
              "platform-performance"
            ]
          },
          "issueType": {
            "const": "DESIGN_MISMATCH"
          },
          "informationMismatch": {
            "type": "boolean"
          },
          "playerFacingEvidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "contributingDomains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "arena-multi-arena",
                "inventory-economy",
                "progression-wave-objective",
                "chunk-simulation",
                "player-lifecycle",
                "entity-ai-combat",
                "world-structure-mutation",
                "ui-feedback-information",
                "state-ownership",
                "temporal-async",
                "boundary-capacity",
                "persistence-recovery",
                "platform-performance"
              ]
            }
          },
          "validationReason": {
            "type": "string",
            "minLength": 1
          },
          "missingProof": {
            "type": "string",
            "minLength": 1
          },
          "validationTest": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PROVEN"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "severity",
                "playerImpact",
                "counterEvidence",
                "testerTriggerReady"
              ],
              "properties": {
                "counterEvidence": {
                  "const": "cleared"
                },
                "testerTriggerReady": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "NEED_VALIDATION"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "validationReason",
                "missingProof",
                "validationTest"
              ],
              "not": {
                "required": [
                  "severity"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "informationMismatch": {
                  "const": true
                }
              },
              "required": [
                "informationMismatch"
              ]
            },
            "then": {
              "required": [
                "playerFacingEvidenceIds"
              ]
            }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
