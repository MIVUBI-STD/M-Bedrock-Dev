{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M-Bedrock Map Audit Output V2",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactId",
    "mapVersion",
    "evidenceScope",
    "gameDesign",
    "gameplayClosure",
    "gameplayFlow",
    "stateTransitions",
    "multiArena",
    "coverage",
    "bugs",
    "designMismatches",
    "honesty",
    "validationTests",
    "control",
    "auditObligations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "artifactId": {
      "type": "string",
      "minLength": 1
    },
    "mapVersion": {
      "type": "string",
      "minLength": 1
    },
    "evidenceScope": {
      "type": "object",
      "required": [
        "mode",
        "selectedArtifact",
        "archiveSourcesUsed"
      ],
      "properties": {
        "mode": {
          "const": "selected-map-version-only"
        },
        "selectedArtifact": {
          "type": "string",
          "minLength": 1
        },
        "archiveSourcesUsed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "gameDesign": {
      "type": "object",
      "required": [
        "objective",
        "winCondition",
        "loseCondition",
        "resetRules",
        "preserveRules",
        "progressionRules",
        "objectiveGrounding",
        "winConditionGrounding",
        "loseConditionGrounding"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "winCondition": {
          "type": "string",
          "minLength": 1
        },
        "loseCondition": {
          "type": "string",
          "minLength": 1
        },
        "resetRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserveRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "progressionRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objectiveGrounding": {
          "enum": [
            "authored",
            "inferred",
            "unresolved"
          ]
        },
        "winConditionGrounding": {
          "enum": [
            "authored",
            "inferred",
            "unresolved"
          ]
        },
        "loseConditionGrounding": {
          "enum": [
            "authored",
            "inferred",
            "unresolved"
          ]
        }
      },
      "additionalProperties": true
    },
    "gameplayFlow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stateTransitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "event",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "multiArena": {
      "type": "object",
      "required": [
        "detected",
        "visibleArenaCount",
        "declaredConcurrentArenaLimit",
        "safeConcurrentArenaLimit",
        "queueBehavior",
        "isolationRules"
      ],
      "properties": {
        "detected": {
          "type": "boolean"
        },
        "visibleArenaCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "declaredConcurrentArenaLimit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "safeConcurrentArenaLimit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "queueBehavior": {
          "type": "string"
        },
        "isolationRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "disposition",
        "records"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "accounted",
            "incomplete"
          ]
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "surface",
              "status"
            ],
            "properties": {
              "surface": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "understood",
                  "blocked",
                  "not-applicable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "blocked"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "reason"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "not-applicable"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "reason"
                  ]
                }
              }
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "bugs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "gameplayFlow",
          "failureDomain",
          "informationMismatch",
          "issue",
          "reproduceSteps",
          "expected",
          "actual",
          "proofCeiling",
          "issueType",
          "contributingDomains"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PROVEN",
              "NEED_VALIDATION"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "deprecated": true,
            "description": "Legacy compatibility metadata. failureDomain is the canonical audit taxonomy."
          },
          "gameplayFlow": {
            "enum": [
              "ENTRY_JOIN",
              "READY_START",
              "SETUP",
              "ACTIVE_GAMEPLAY",
              "PROGRESSION",
              "TERMINAL",
              "CLEANUP_REPLAY",
              "RECOVERY"
            ]
          },
          "severity": {
            "enum": [
              "Blocker",
              "Major",
              "Minor"
            ]
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "playerImpact": {
            "type": "string"
          },
          "reproduceSteps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "proofCeiling": {
            "enum": [
              "PROVEN",
              "NEEDS_DECIDING_PROOF"
            ]
          },
          "counterEvidence": {
            "enum": [
              "cleared",
              "unresolved"
            ]
          },
          "failureDomain": {
            "enum": [
              "arena-multi-arena",
              "inventory-economy",
              "progression-wave-objective",
              "chunk-simulation",
              "player-lifecycle",
              "entity-ai-combat",
              "world-structure-mutation",
              "ui-feedback-information",
              "state-ownership",
              "temporal-async",
              "boundary-capacity",
              "persistence-recovery",
              "platform-performance"
            ]
          },
          "issueType": {
            "const": "BUG"
          },
          "informationMismatch": {
            "type": "boolean"
          },
          "playerFacingEvidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "contributingDomains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "arena-multi-arena",
                "inventory-economy",
                "progression-wave-objective",
                "chunk-simulation",
                "player-lifecycle",
                "entity-ai-combat",
                "world-structure-mutation",
                "ui-feedback-information",
                "state-ownership",
                "temporal-async",
                "boundary-capacity",
                "persistence-recovery",
                "platform-performance"
              ]
            }
          },
          "validationReason": {
            "type": "string",
            "minLength": 1
          },
          "missingProof": {
            "type": "string",
            "minLength": 1
          },
          "validationTest": {
            "type": "string",
            "minLength": 1
          },
          "validationGroupKey": {
            "type": "string",
            "minLength": 1
          },
          "proofNavigation": {
            "type": "object",
            "required": [
              "recipeId",
              "proofGoal",
              "provenClaims",
              "missingClaims",
              "route",
              "evidenceSubstitutions",
              "historicalSearchHints",
              "historyPressure",
              "familyProofCriteria",
              "proofStopRule",
              "runtimeLastResort"
            ],
            "properties": {
              "recipeId": {
                "type": "string",
                "minLength": 1
              },
              "proofGoal": {
                "type": "string",
                "minLength": 1
              },
              "provenClaims": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "missingClaims": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "route": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "order",
                    "knowledgeDomain",
                    "question",
                    "purpose",
                    "evidencePreference"
                  ],
                  "properties": {
                    "order": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "knowledgeDomain": {
                      "type": "string",
                      "minLength": 1
                    },
                    "question": {
                      "type": "string",
                      "minLength": 1
                    },
                    "purpose": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidencePreference": {
                      "enum": [
                        "selected-artifact",
                        "cross-domain",
                        "formal",
                        "runtime"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "evidenceSubstitutions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "replaces",
                    "requiredEvidence",
                    "applicableBecause",
                    "decisionRule"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "replaces": {
                      "type": "string",
                      "minLength": 1
                    },
                    "requiredEvidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "applicableBecause": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "decisionRule": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "historicalSearchHints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "family",
                    "priority",
                    "knowledgeDomains",
                    "searchQuestions",
                    "matchedBecause"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "family": {
                      "type": "string",
                      "minLength": 1
                    },
                    "priority": {
                      "enum": [
                        "high",
                        "medium"
                      ]
                    },
                    "knowledgeDomains": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "searchQuestions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "matchedBecause": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "additionalProperties": true
                }
              },
              "historyPressure": {
                "type": "number",
                "minimum": 0
              },
              "runtimeLastResort": {
                "const": true
              },
              "familyProofCriteria": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "proofStopRule": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PROVEN"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "playerImpact",
                "counterEvidence"
              ],
              "properties": {
                "counterEvidence": {
                  "const": "cleared"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "NEED_VALIDATION"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "validationReason",
                "missingProof",
                "validationTest",
                "validationGroupKey",
                "proofNavigation"
              ],
              "not": {
                "required": [
                  "severity"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "informationMismatch": {
                  "const": true
                }
              },
              "required": [
                "informationMismatch"
              ]
            },
            "then": {
              "required": [
                "playerFacingEvidenceIds"
              ]
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "gameplayClosure": {
      "type": "object",
      "required": [
        "status",
        "surfaceInventory",
        "stateModelComplete",
        "boundariesExtracted",
        "unaccountedSurfaceIds"
      ],
      "properties": {
        "status": {
          "enum": [
            "CLOSED",
            "PARTIAL",
            "OPEN"
          ]
        },
        "surfaceInventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "understood",
                  "blocked",
                  "unknown",
                  "not-applicable"
                ]
              },
              "reason": {
                "type": "string"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "boundaries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "blocked",
                        "unknown",
                        "not-applicable"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "reason"
                  ]
                }
              }
            ],
            "additionalProperties": true
          }
        },
        "stateModelComplete": {
          "type": "boolean"
        },
        "boundariesExtracted": {
          "type": "boolean"
        },
        "unaccountedSurfaceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "CLOSED",
                  "PARTIAL"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "unaccountedSurfaceIds": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "OPEN"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "unaccountedSurfaceIds": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "stateModelComplete": {
                    "const": false
                  }
                },
                "required": [
                  "stateModelComplete"
                ]
              },
              {
                "properties": {
                  "boundariesExtracted": {
                    "const": false
                  }
                },
                "required": [
                  "boundariesExtracted"
                ]
              }
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "designMismatches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "gameplayFlow",
          "failureDomain",
          "informationMismatch",
          "issue",
          "reproduceSteps",
          "expected",
          "actual",
          "proofCeiling",
          "issueType",
          "contributingDomains"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PROVEN",
              "NEED_VALIDATION"
            ]
          },
