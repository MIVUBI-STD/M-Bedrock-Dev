{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DEPRECATED — M-Bedrock Map Audit Output V1",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactId",
    "mapVersion",
    "evidenceScope",
    "coverage",
    "candidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifactId": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "disposition",
          "proofCeiling",
          "subjectIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "defect",
              "designed-behavior",
              "ambiguous-intent",
              "insufficient-evidence",
              "runtime-proof-required",
              "detection-gap"
            ]
          },
          "proofCeiling": {
            "enum": [
              "STATIC VERIFIED",
              "PACKAGE VERIFIED",
              "LOCAL GAME VERIFIED",
              "LIVE GAME VERIFIED",
              "UNKNOWN"
            ]
          },
          "severity": {
            "enum": [
              "Blocker",
              "Major",
              "Minor"
            ]
          },
          "expectedAuthority": {
            "const": "selected-artifact"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nextOwner": {
            "type": "string"
          },
          "playerImpact": {
            "enum": [
              "blocking",
              "material",
              "limited",
              "none"
            ]
          },
          "counterEvidence": {
            "enum": [
              "cleared",
              "present",
              "unresolved"
            ]
          },
          "testerTriggerReady": {
            "type": "boolean"
          },
          "subjectIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "defect"
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "required": [
                "severity",
                "expectedAuthority",
                "playerImpact",
                "counterEvidence",
                "testerTriggerReady"
              ],
              "properties": {
                "playerImpact": {
                  "enum": [
                    "blocking",
                    "material",
                    "limited"
                  ]
                },
                "counterEvidence": {
                  "const": "cleared"
                },
                "testerTriggerReady": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "disposition": {
                  "enum": [
                    "designed-behavior",
                    "ambiguous-intent",
                    "insufficient-evidence",
                    "runtime-proof-required",
                    "detection-gap"
                  ]
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "severity"
                ]
              }
            }
          }
        ]
      }
    },
    "mapVersion": {
      "type": "string",
      "minLength": 1
    },
    "evidenceScope": {
      "type": "object",
      "required": [
        "mode",
        "selectedArtifact",
        "archiveSourcesUsed"
      ],
      "properties": {
        "mode": {
          "const": "selected-map-version-only"
        },
        "selectedArtifact": {
          "type": "string",
          "minLength": 1
        },
        "archiveSourcesUsed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "disposition",
        "scope",
        "discoveryCompleteness",
        "totalSurfaces",
        "checked",
        "blocked",
        "notApplicable",
        "missingSubjectIds",
        "records"
      ],
      "properties": {
        "disposition": {
          "const": "accounted"
        },
        "totalSurfaces": {
          "type": "integer",
          "minimum": 0
        },
        "checked": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "notApplicable": {
          "type": "integer",
          "minimum": 0
        },
        "missingSubjectIds": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "const": "discovered-surfaces-only"
        },
        "discoveryCompleteness": {
          "const": "not-proven"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "subjectId",
              "status"
            ],
            "properties": {
              "subjectId": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "checked",
                  "blocked",
                  "not-applicable"
                ]
              },
              "candidateIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "blocked"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "reason"
                  ]
                }
              }
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$comment": "Compatibility-only legacy schema. Production selected-map audit uses map-audit-output-v2.schema.json through runSelectedMapAudit(); this schema cannot authorize audit completion.",
  "x-status": "deprecated-non-production"
}
